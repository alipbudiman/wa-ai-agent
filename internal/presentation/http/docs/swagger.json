{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Gin HTTP API for WhatsApp bot utilities and integrations.",
        "title": "WA AI Agent HTTP API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8001",
    "basePath": "/",
    "paths": {
        "/v1/contact/info/{number}": {
            "get": {
                "description": "Resolve contact details from a WhatsApp number or full JID (e.g. 6281234567890, 867051314767696@lid)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "contact"
                ],
                "summary": "Get WhatsApp contact info",
                "parameters": [
                    {
                        "type": "string",
                        "description": "WhatsApp Number or JID",
                        "name": "number",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/route.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/me": {
            "get": {
                "description": "Return WhatsApp account information of the connected bot",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Get self information",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/route.SuccessResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/message/broadcast": {
            "post": {
                "description": "Send a text message to all saved contacts",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "message"
                ],
                "summary": "Broadcast a WhatsApp message",
                "parameters": [
                    {
                        "description": "Broadcast message payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/route.BroadcastMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/route.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/message/send": {
            "post": {
                "description": "Send a text message to a specific WhatsApp number",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "message"
                ],
                "summary": "Send a WhatsApp message",
                "parameters": [
                    {
                        "description": "Send message payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/route.SendMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/route.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/message/send-file": {
            "post": {
                "description": "Send a file message to a specific WhatsApp number",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "message"
                ],
                "summary": "Send a WhatsApp file",
                "parameters": [
                    {
                        "description": "Send file payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/route.SendFileRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/route.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/route.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "route.BroadcastMessageRequest": {
            "type": "object",
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "route.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Request failed"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "route.SendFileRequest": {
            "type": "object",
            "required": [
                "file_path",
                "number"
            ],
            "properties": {
                "caption": {
                    "type": "string"
                },
                "file_path": {
                    "type": "string"
                },
                "number": {
                    "type": "string"
                }
            }
        },
        "route.SendMessageRequest": {
            "type": "object",
            "required": [
                "message",
                "number"
            ],
            "properties": {
                "message": {
                    "type": "string"
                },
                "number": {
                    "type": "string"
                },
                "store": {
                    "type": "boolean"
                }
            }
        },
        "route.SuccessResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Request succeeded"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}