<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>WA AI Agent Control Hub</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<style>
		:root {
			--color-bg: #090909;
			--color-bg-soft: #121212;
			--color-panel: #1a1a1a;
			--color-panel-line: rgba(255, 255, 255, 0.1);
			--color-text: #ffffff;
			--color-muted: #a0a0a0;
			--color-accent: #d4ed31;
			--color-cyan: #00e5ff;
			--color-danger: #ff4d5f;
			--font-primary: "Rajdhani", "Segoe UI", sans-serif;
			--font-mono: "JetBrains Mono", Consolas, monospace;
		}

		body {
			min-height: 100vh;
			background-color: var(--color-bg);
			color: var(--color-text);
			font-family: var(--font-primary);
			background-image:
				linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				radial-gradient(circle at 14% -8%, rgba(212, 237, 49, 0.15), transparent 34%),
				radial-gradient(circle at 100% 0%, rgba(0, 229, 255, 0.1), transparent 28%);
			background-size: 36px 36px, 36px 36px, auto, auto;
		}

		.hub-shell {
			max-width: 1360px;
		}

		.top-bar {
			border: 1px solid var(--color-panel-line);
			background: linear-gradient(155deg, rgba(26, 26, 26, 0.95), rgba(12, 12, 12, 0.95));
			box-shadow: 0 14px 26px rgba(0, 0, 0, 0.35);
		}

		.top-bar .brand {
			font-family: var(--font-mono);
			letter-spacing: 0.1em;
			font-size: 0.76rem;
			color: var(--color-accent);
			text-transform: uppercase;
		}

		.top-bar .title {
			letter-spacing: 0.04em;
			text-transform: uppercase;
			margin-bottom: 0;
		}

		.stats {
			font-family: var(--font-mono);
			color: #d7d7d7;
			font-size: 0.78rem;
			letter-spacing: 0.03em;
		}

		.menu-panel {
			border: 1px solid var(--color-panel-line);
			background: linear-gradient(145deg, rgba(24, 24, 24, 0.95), rgba(14, 14, 14, 0.95));
			box-shadow: 0 14px 24px rgba(0, 0, 0, 0.35);
		}

		.menu-label {
			font-family: var(--font-mono);
			color: var(--color-muted);
			font-size: 0.72rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.menu-btn {
			width: 100%;
			text-align: left;
			color: #f0f0f0;
			border: 1px solid rgba(255, 255, 255, 0.18);
			background: linear-gradient(120deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
			border-radius: 0.7rem;
			margin-bottom: 0.6rem;
			padding: 0.85rem 0.9rem;
			text-transform: uppercase;
			letter-spacing: 0.03em;
			font-weight: 600;
			transition: all 0.2s ease;
		}

		.menu-btn:hover,
		.menu-btn:focus-visible {
			border-color: rgba(212, 237, 49, 0.7);
			box-shadow: 0 0 0 0.2rem rgba(212, 237, 49, 0.15);
			transform: translateY(-1px);
			color: #ffffff;
		}

		.menu-btn .icon {
			font-family: var(--font-mono);
			color: var(--color-accent);
			margin-right: 0.55rem;
		}

		.menu-btn-active {
			border-color: rgba(212, 237, 49, 0.9);
			background: linear-gradient(120deg, rgba(212, 237, 49, 0.16), rgba(212, 237, 49, 0.06));
			color: #fffed0;
		}

		.core-wrap {
			position: relative;
			border: 1px solid var(--color-panel-line);
			background: radial-gradient(circle at 50% 10%, rgba(255, 255, 255, 0.05), rgba(11, 11, 11, 0.95));
			box-shadow: 0 18px 30px rgba(0, 0, 0, 0.36);
			min-height: 570px;
			overflow: hidden;
		}

		.orbital-ring {
			width: min(68vw, 520px);
			aspect-ratio: 1 / 1;
			margin: 1.6rem auto 1.4rem;
			border-radius: 50%;
			padding: 13px;
			border: 1px solid rgba(212, 237, 49, 0.5);
			background:
				conic-gradient(from 20deg, rgba(212, 237, 49, 0.32), rgba(0, 229, 255, 0.14), rgba(212, 237, 49, 0.32));
			position: relative;
			box-shadow: inset 0 0 28px rgba(212, 237, 49, 0.1), 0 0 25px rgba(0, 0, 0, 0.4);
		}

		.orbital-ring::before,
		.orbital-ring::after {
			content: "";
			position: absolute;
			border-radius: 50%;
			border: 1px dashed rgba(255, 255, 255, 0.2);
			inset: 8%;
		}

		.orbital-ring::after {
			inset: 17%;
			border-style: solid;
			border-color: rgba(255, 255, 255, 0.09);
		}

		.video-core {
			width: 100%;
			height: 100%;
			border-radius: 50%;
			overflow: hidden;
			border: 1px solid rgba(255, 255, 255, 0.24);
			position: relative;
			background-color: #0a0a0a;
		}

		.video-layer {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.video-layer-hub video {
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0.84;
			filter: contrast(1.08) saturate(1.06);
		}

		.video-overlay {
			position: absolute;
			inset: 0;
			pointer-events: none;
			display: flex;
			align-items: center;
			justify-content: center;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			font-size: clamp(1.2rem, 2.7vw, 1.95rem);
			color: rgba(255, 255, 255, 0.86);
			text-shadow: 0 3px 16px rgba(0, 0, 0, 0.7);
			background: radial-gradient(circle, rgba(0, 0, 0, 0.08) 26%, rgba(0, 0, 0, 0.34) 100%);
		}

		.floating-notification {
			position: fixed;
			top: 0.9rem;
			left: 50%;
			transform: translate(-50%, -10px);
			z-index: 1200;
			display: flex;
			align-items: center;
			gap: 0.6rem;
			max-width: min(560px, calc(100vw - 1.4rem));
			padding: 0.7rem 0.95rem;
			border: 1px solid rgba(0, 229, 255, 0.4);
			background: rgba(0, 229, 255, 0.09);
			backdrop-filter: blur(6px);
			border-radius: 0.65rem;
			color: #c9f7ff;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.03em;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
		}

		.floating-notification.show {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, 0);
		}

		.floating-notification-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 50%;
			background: var(--color-accent);
			box-shadow: 0 0 10px rgba(212, 237, 49, 0.8);
			flex-shrink: 0;
		}

		.page-loading-modal {
			position: fixed;
			inset: 0;
			z-index: 1400;
			display: flex;
			align-items: center;
			justify-content: center;
			background: rgba(6, 6, 6, 0.88);
			backdrop-filter: blur(4px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: opacity 0.2s ease, visibility 0.2s ease;
		}

		.page-loading-modal.show {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.page-loading-card {
			min-width: min(420px, calc(100vw - 2rem));
			padding: 1.2rem 1.3rem;
			border-radius: 0.8rem;
			border: 1px solid rgba(0, 229, 255, 0.34);
			background: linear-gradient(145deg, rgba(12, 20, 22, 0.95), rgba(9, 9, 9, 0.95));
			box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45);
			display: flex;
			align-items: center;
			gap: 0.8rem;
		}

		.page-loading-spinner {
			width: 1rem;
			height: 1rem;
			border-radius: 50%;
			border: 2px solid rgba(255, 255, 255, 0.2);
			border-top-color: var(--color-accent);
			animation: spin 0.75s linear infinite;
		}

		.page-loading-text {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.04em;
			color: #c9f7ff;
		}

		.qr-panel {
			max-width: 460px;
			margin: 0 auto;
			padding: 0.95rem;
			border-radius: 0.75rem;
			border: 1px solid rgba(255, 255, 255, 0.14);
			background: linear-gradient(160deg, rgba(19, 19, 19, 0.96), rgba(10, 10, 10, 0.96));
		}

		.qr-core-canvas {
			width: min(78%, 320px);
			aspect-ratio: 1 / 1;
			padding: 0.45rem;
			border-radius: 0.7rem;
			border: 1px solid rgba(0, 229, 255, 0.4);
			background: rgba(255, 255, 255, 0.05);
			display: grid;
			place-items: center;
		}

		.qr-core-canvas img,
		.qr-core-canvas canvas {
			max-width: 100%;
			height: auto;
			border-radius: 0.35rem;
			background: #ffffff;
			padding: 0.35rem;
		}

		.qr-placeholder {
			font-family: var(--font-mono);
			font-size: 0.76rem;
			color: #d0d0d0;
			letter-spacing: 0.03em;
			text-transform: uppercase;
			padding: 0.4rem;
		}

		.qr-status-text {
			font-family: var(--font-mono);
			font-size: 0.76rem;
			letter-spacing: 0.03em;
			color: #d9edf1;
			margin-bottom: 0.3rem;
		}

		.qr-status-hint {
			font-family: var(--font-mono);
			font-size: 0.7rem;
			letter-spacing: 0.04em;
			color: #8ea1a7;
		}

		.qr-status-text[data-state="connected"],
		.qr-status-text[data-state="already_logged_in"] {
			color: #dbf7a2;
		}

		.qr-status-text[data-state="error"] {
			color: #ffadb7;
		}

		.hub-switch-group {
			display: flex;
			justify-content: center;
			gap: 0.5rem;
		}

		.hub-switch-btn {
			border: 1px solid rgba(255, 255, 255, 0.2);
			border-radius: 0.58rem;
			padding: 0.5rem 0.75rem;
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: #d9ecef;
			background: rgba(255, 255, 255, 0.05);
			transition: all 0.2s ease;
		}

		.hub-switch-btn:hover,
		.hub-switch-btn:focus-visible {
			border-color: rgba(0, 229, 255, 0.55);
			box-shadow: 0 0 0 0.2rem rgba(0, 229, 255, 0.16);
			color: #ffffff;
		}

		.hub-switch-btn.active {
			border-color: rgba(212, 237, 49, 0.8);
			background: rgba(212, 237, 49, 0.17);
			color: #f6ffd2;
		}

		@keyframes spin {
			to { transform: rotate(360deg); }
		}

		.hub-footer {
			font-family: var(--font-mono);
			color: #838383;
			font-size: 0.72rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		@media (max-width: 991.98px) {
			.core-wrap {
				min-height: auto;
			}

			.orbital-ring {
				width: min(84vw, 430px);
				margin-top: 1.1rem;
			}
		}
	</style>
</head>
<body>
	<div id="floatingNotification" class="floating-notification" role="status" aria-live="polite">
		<span class="floating-notification-dot" aria-hidden="true"></span>
		<span id="floatingNotificationText"></span>
	</div>

	<div id="pageLoadingModal" class="page-loading-modal" aria-hidden="true">
		<div class="page-loading-card" role="status" aria-live="polite">
			<span class="page-loading-spinner" aria-hidden="true"></span>
			<span class="page-loading-text" id="pageLoadingText">Opening Reports and syncing traces...</span>
		</div>
	</div>

	<main class="container hub-shell py-4 py-lg-5">
		<section class="top-bar rounded-3 p-3 p-lg-4 mb-4">
			<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
				<div>
					<p class="brand mb-2">// wa ai agent</p>
					<h1 class="title h4">Operations Hub</h1>
				</div>
				<div class="d-flex flex-wrap gap-3 stats">
					<span>[ signal ] stable</span>
					<span>[ session ] online</span>
					<span>[ node ] local</span>
				</div>
			</div>
		</section>

		<section class="row g-4 align-items-stretch">
			<aside class="col-12 col-lg-3 order-2 order-lg-1">
				<nav class="menu-panel rounded-3 p-3 h-100" aria-label="Left menu">
					<p class="menu-label mb-3">[ navigation ] left</p>
                    <a href="/access" class="menu-btn menu-btn-active d-block text-decoration-none"><span class="icon">01</span>Access Manager</a>
					<a href="/reports" id="reportsNavLink" class="menu-btn menu-btn-active d-block text-decoration-none"><span class="icon">02</span>Reports</a>
                    <a href="/inbox" class="menu-btn menu-btn-active d-block text-decoration-none"><span class="icon">03</span>Inbox</a>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">04</span>Acquisition</button>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">05</span>Broadcast</button>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">06</span>Contacts</button>
				</nav>
			</aside>

			<section class="col-12 col-lg-6 order-1 order-lg-2" aria-label="Center hub">
				<article class="core-wrap rounded-3 p-3 p-lg-4 text-center h-100">
					<div class="orbital-ring">
						<div class="video-core">
							<div id="hubVisualLayer" class="video-layer video-layer-hub">
								<video autoplay muted loop playsinline preload="auto" aria-label="Center video stream">
									<source src="https://raw.githubusercontent.com/alipbudiman/asset/main/tantan.mp4" type="video/mp4" />
									Your browser does not support HTML5 video playback.
								</video>
								<div class="video-overlay">The Hub</div>
							</div>
							<div id="qrVisualLayer" class="video-layer video-layer-qr d-none">
								<div id="qrCoreCanvas" class="qr-core-canvas" aria-live="polite">
									<p class="qr-placeholder mb-0">Waiting for QR code...</p>
								</div>
							</div>
						</div>
					</div>
					<div class="qr-panel mt-2">
						<p class="menu-label mb-2">[ bot auth ] qr login</p>
						<p id="qrStatusText" class="qr-status-text" data-state="idle">Checking WhatsApp session...</p>
						<p class="qr-status-hint mb-2">Auto-refresh every 2 seconds while waiting for scan.</p>
						<div class="hub-switch-group" role="group" aria-label="Hub visual mode switch">
							<button id="switchToHubBtn" type="button" class="hub-switch-btn active">The Hub</button>
							<button id="switchToQRBtn" type="button" class="hub-switch-btn">QR Login</button>
						</div>
					</div>
				</article>
			</section>

			<aside class="col-12 col-lg-3 order-3" aria-label="Right menu">
				<nav class="menu-panel rounded-3 p-3 h-100">
					<p class="menu-label mb-3">[ navigation ] right</p>
					<a href="https://smith.langchain.com/" target="_blank" rel="noopener noreferrer" class="menu-btn menu-btn-active d-block text-decoration-none"><span class="icon">07</span>LangSmith</a>
                    <a href="/artifacts" class="menu-btn menu-btn-active d-block text-decoration-none"><span class="icon">08</span>artifacts</a>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">09</span>Operators</button>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">10</span>Database</button>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">11</span>Valuables</button>
					<button type="button" class="menu-btn menu-dummy"><span class="icon">12</span>Archive</button>
				</nav>
			</aside>
		</section>

		<footer class="hub-footer mt-3 text-center">WhatsApp Agnetic AI - WaNexus 2.0 • web control module</footer>
	</main>

	<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
	<script>
		const floatingNotification = document.getElementById("floatingNotification");
		const floatingNotificationText = document.getElementById("floatingNotificationText");
		const dummyButtons = document.querySelectorAll(".menu-dummy");
		const reportsNavLink = document.getElementById("reportsNavLink");
		const pageLoadingModal = document.getElementById("pageLoadingModal");
		const pageLoadingText = document.getElementById("pageLoadingText");
		const qrCodeCanvas = document.getElementById("qrCoreCanvas");
		const qrStatusText = document.getElementById("qrStatusText");
		const qrStatusEndpoint = "/api/bot/qr/status";
		const hubVisualLayer = document.getElementById("hubVisualLayer");
		const qrVisualLayer = document.getElementById("qrVisualLayer");
		const switchToHubBtn = document.getElementById("switchToHubBtn");
		const switchToQRBtn = document.getElementById("switchToQRBtn");

		let qrPollingTimer = null;
		let lastQRCode = "";
		let lastQRState = "";
		let isManualVisualMode = false;

		function setActiveSwitchButton(mode) {
			switchToHubBtn.classList.toggle("active", mode === "hub");
			switchToQRBtn.classList.toggle("active", mode === "qr");
		}

		function setVisualMode(mode) {
			if (mode === "qr") {
				hubVisualLayer.classList.add("d-none");
				qrVisualLayer.classList.remove("d-none");
				setActiveSwitchButton("qr");
				return;
			}

			hubVisualLayer.classList.remove("d-none");
			qrVisualLayer.classList.add("d-none");
			setActiveSwitchButton("hub");
		}

		function syncVisualWithQRState(state, hasQRCode) {
			const normalizedState = String(state || "idle").toLowerCase();

			if (normalizedState === "connected" || normalizedState === "already_logged_in") {
				setVisualMode("hub");
				return;
			}

			if (isManualVisualMode) {
				return;
			}

			if (
				normalizedState === "scan_required" ||
				normalizedState === "awaiting_scan" ||
				normalizedState === "initializing" ||
				hasQRCode
			) {
				setVisualMode("qr");
				return;
			}

			setVisualMode("hub");
		}

		function clearQRCodeCanvas() {
			qrCodeCanvas.innerHTML = "";
		}

		function renderQRPlaceholder(state) {
			clearQRCodeCanvas();
			const placeholder = document.createElement("p");
			placeholder.className = "qr-placeholder mb-0";

			if (state === "connected" || state === "already_logged_in") {
				placeholder.textContent = "Bot is already connected.";
			} else if (state === "error") {
				placeholder.textContent = "Unable to load QR code right now.";
			} else {
				placeholder.textContent = "Waiting for QR code...";
			}

			qrCodeCanvas.appendChild(placeholder);
		}

		function renderQRCode(qrCode) {
			if (!qrCode) {
				renderQRPlaceholder(lastQRState);
				return;
			}

			clearQRCodeCanvas();

			if (typeof window.QRCode !== "function") {
				renderQRPlaceholder("error");
				return;
			}

			new window.QRCode(qrCodeCanvas, {
				text: qrCode,
				width: 220,
				height: 220,
				colorDark: "#0b0b0b",
				colorLight: "#ffffff",
				correctLevel: window.QRCode.CorrectLevel.M,
			});
		}

		function setQRStatus(state, message) {
			const normalizedState = String(state || "idle").trim().toLowerCase();
			qrStatusText.dataset.state = normalizedState;

			if (message) {
				qrStatusText.textContent = message;
				return;
			}

			switch (normalizedState) {
				case "scan_required":
					qrStatusText.textContent = "Scan this QR code using WhatsApp mobile app.";
					break;
				case "already_logged_in":
				case "connected":
					qrStatusText.textContent = "Bot is connected. QR scan is not required.";
					break;
				case "error":
					qrStatusText.textContent = "Failed to load QR status from server.";
					break;
				default:
					qrStatusText.textContent = "Waiting for WhatsApp login status...";
			}
		}

		function stopQRPolling() {
			if (!qrPollingTimer) {
				return;
			}

			window.clearInterval(qrPollingTimer);
			qrPollingTimer = null;
		}

		function startQRPolling() {
			if (qrPollingTimer) {
				return;
			}

			qrPollingTimer = window.setInterval(fetchQRStatus, 2000);
		}

		async function fetchQRStatus() {
			try {
				const response = await fetch(qrStatusEndpoint, {
					headers: {
						Accept: "application/json",
						"Cache-Control": "no-cache",
					},
				});

				if (!response.ok) {
					throw new Error(`status ${response.status}`);
				}

				const payload = await response.json();
				const qrPayload = payload && payload.success ? payload.data : null;

				if (!qrPayload) {
					throw new Error("invalid QR payload");
				}

				const nextState = String(qrPayload.state || "idle");
				const nextCode = String(qrPayload.code || "");
				const nextMessage = String(qrPayload.message || "");

				setQRStatus(nextState, nextMessage);
				syncVisualWithQRState(nextState, Boolean(nextCode));

				if (nextState !== lastQRState || nextCode !== lastQRCode) {
					if (nextCode) {
						renderQRCode(nextCode);
					} else {
						renderQRPlaceholder(nextState);
					}

					lastQRState = nextState;
					lastQRCode = nextCode;
				}

				if (nextState === "connected" || nextState === "already_logged_in") {
					stopQRPolling();
				} else {
					startQRPolling();
				}
			} catch (error) {
				setQRStatus("error", "Failed to sync QR status. Retrying...");
				renderQRPlaceholder("error");
			}
		}

		function showComingSoon(message) {
			floatingNotificationText.textContent = message;
			floatingNotification.classList.add("show");

			window.clearTimeout(showComingSoon.timeout);
			showComingSoon.timeout = window.setTimeout(() => {
				floatingNotification.classList.remove("show");
			}, 2600);
		}

		dummyButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const label = button.textContent.trim();
				showComingSoon(`[ ${label} ] module is not available yet.`);
			});
		});

		reportsNavLink.addEventListener("click", (event) => {
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
				return;
			}

			event.preventDefault();
			pageLoadingText.textContent = "Opening Reports and syncing traces...";
			pageLoadingModal.classList.add("show");

			const targetURL = reportsNavLink.getAttribute("href") || "/reports";
			window.setTimeout(() => {
				window.location.assign(targetURL);
			}, 80);
		});

		switchToHubBtn.addEventListener("click", () => {
			isManualVisualMode = true;
			setVisualMode("hub");
		});

		switchToQRBtn.addEventListener("click", () => {
			isManualVisualMode = true;
			setVisualMode("qr");
			if (!lastQRCode) {
				renderQRPlaceholder(lastQRState);
			}
		});

		fetchQRStatus();
		startQRPolling();
	</script>
</body>
</html>
