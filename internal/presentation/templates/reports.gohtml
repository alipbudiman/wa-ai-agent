<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>LangSmith Reports Dashboard</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<style>
		:root {
			--color-bg: #090909;
			--color-bg-soft: #121212;
			--color-panel: #1a1a1a;
			--color-panel-line: rgba(255, 255, 255, 0.1);
			--color-text: #ffffff;
			--color-muted: #a0a0a0;
			--color-accent: #d4ed31;
			--color-cyan: #00e5ff;
			--color-danger: #ff4d5f;
			--font-primary: "Rajdhani", "Segoe UI", sans-serif;
			--font-mono: "JetBrains Mono", Consolas, monospace;
		}

		body {
			font-family: var(--font-primary);
			color: var(--color-text);
			background-color: var(--color-bg);
			background-image:
				linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				radial-gradient(circle at 11% -9%, rgba(212, 237, 49, 0.17), transparent 36%),
				radial-gradient(circle at 93% 5%, rgba(0, 229, 255, 0.12), transparent 28%);
			background-size: 40px 40px, 40px 40px, auto, auto;
			min-height: 100vh;
		}

		.tech-shell {
			max-width: 1320px;
		}

		.panel {
			background: linear-gradient(145deg, rgba(26, 26, 26, 0.98), rgba(18, 18, 18, 0.98));
			border: 1px solid var(--color-panel-line);
			box-shadow: 0 20px 34px rgba(0, 0, 0, 0.35);
		}

		.hero-panel {
			position: relative;
			overflow: hidden;
		}

		.hero-panel::after {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(120deg, rgba(0, 229, 255, 0.09), transparent 42%);
			pointer-events: none;
		}

		.tech-kicker {
			font-family: var(--font-mono);
			font-size: 0.74rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--color-accent);
		}

		.section-title {
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-size: 1.08rem;
			margin-bottom: 1rem;
		}

		.text-muted-tech {
			color: var(--color-muted) !important;
		}

		.muted-text {
			color: var(--color-muted);
		}

		.muted-text a {
			color: #d6d6d6;
		}

		.muted-text a:hover {
			color: #ffffff;
		}

		.font-mono {
			font-family: var(--font-mono);
		}

		.feedback-toast {
			position: fixed;
			top: 1.05rem;
			right: 1rem;
			z-index: 1320;
			min-width: 270px;
			max-width: min(92vw, 460px);
			padding: 0.7rem 0.9rem;
			border: 1px solid rgba(0, 229, 255, 0.46);
			background: rgba(0, 229, 255, 0.13);
			color: #d8fbff;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			letter-spacing: 0.03em;
			border-radius: 0.62rem;
			box-shadow: 0 14px 26px rgba(0, 0, 0, 0.42);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-12px);
			pointer-events: none;
			transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
		}

		.feedback-toast.is-hidden {
			opacity: 0;
			visibility: hidden;
			transform: translateY(-12px);
		}

		.feedback-toast:not(.is-hidden) {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.feedback-toast.is-warning {
			border-color: rgba(255, 214, 107, 0.54);
			background: rgba(255, 214, 107, 0.16);
			color: #ffe8ad;
		}

		.feedback-toast.is-error {
			border-color: rgba(255, 77, 95, 0.56);
			background: rgba(255, 77, 95, 0.17);
			color: #ffd0d5;
		}

		.floating-loading {
			position: fixed;
			top: 0.95rem;
			left: 50%;
			transform: translate(-50%, -12px);
			z-index: 1300;
			display: flex;
			align-items: center;
			gap: 0.62rem;
			max-width: min(560px, calc(100vw - 1.4rem));
			padding: 0.72rem 0.95rem;
			border: 1px solid rgba(0, 229, 255, 0.4);
			background: rgba(0, 229, 255, 0.09);
			backdrop-filter: blur(6px);
			border-radius: 0.65rem;
			color: #c9f7ff;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.03em;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
		}

		.floating-loading.show {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, 0);
		}

		.floating-loading-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 50%;
			background: var(--color-accent);
			box-shadow: 0 0 10px rgba(212, 237, 49, 0.8);
			flex-shrink: 0;
		}

		.btn-tech-outline {
			--bs-btn-color: var(--color-text);
			--bs-btn-border-color: var(--color-panel-line);
			--bs-btn-hover-bg: rgba(255, 255, 255, 0.09);
			--bs-btn-hover-border-color: rgba(255, 255, 255, 0.2);
			--bs-btn-active-bg: rgba(255, 255, 255, 0.12);
			--bs-btn-active-border-color: rgba(255, 255, 255, 0.25);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-primary {
			--bs-btn-bg: var(--color-accent);
			--bs-btn-border-color: var(--color-accent);
			--bs-btn-color: #141414;
			--bs-btn-hover-bg: #e1ff3f;
			--bs-btn-hover-border-color: #e1ff3f;
			--bs-btn-active-bg: #c6df2d;
			--bs-btn-active-border-color: #c6df2d;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.report-table {
			--bs-table-bg: transparent;
			--bs-table-color: var(--color-text);
			--bs-table-border-color: rgba(255, 255, 255, 0.08);
			--bs-table-striped-bg: rgba(255, 255, 255, 0.02);
			--bs-table-hover-bg: rgba(0, 229, 255, 0.09);
			margin-bottom: 0;
		}

		.report-table thead th {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #c6c6c6;
			border-bottom-width: 1px;
			white-space: nowrap;
		}

		.report-table tbody tr.is-selected {
			background: rgba(212, 237, 49, 0.13);
		}

		.table-row-button {
			width: 100%;
			text-align: left;
			border: none;
			background: transparent;
			color: inherit;
			padding: 0;
		}

		.metric-box {
			border: 1px solid var(--color-panel-line);
			background: rgba(255, 255, 255, 0.02);
			border-radius: 0.65rem;
			padding: 0.7rem 0.8rem;
		}

		.metric-label {
			font-family: var(--font-mono);
			font-size: 0.7rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--color-muted);
		}

		.metric-value {
			font-family: var(--font-mono);
			font-size: 0.8rem;
			word-break: break-all;
		}

		.detail-stage {
			position: relative;
			overflow: hidden;
		}

		.detail-transition-overlay {
			position: absolute;
			inset: 0;
			z-index: 30;
			background: rgba(9, 9, 9, 0.84);
			backdrop-filter: blur(2px);
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			transition: opacity 0.18s ease;
		}

		.detail-transition-overlay.show {
			opacity: 1;
		}

		.detail-transition-card {
			min-width: min(380px, calc(100% - 2rem));
			padding: 0.95rem 1.1rem;
			border: 1px solid rgba(0, 229, 255, 0.34);
			border-radius: 0.7rem;
			background: linear-gradient(135deg, rgba(13, 20, 22, 0.95), rgba(10, 10, 10, 0.95));
			box-shadow: 0 14px 28px rgba(0, 0, 0, 0.44);
			display: flex;
			align-items: center;
			gap: 0.7rem;
		}

		.detail-transition-spinner {
			width: 0.95rem;
			height: 0.95rem;
			border-radius: 50%;
			border: 2px solid rgba(255, 255, 255, 0.22);
			border-top-color: var(--color-accent);
			animation: spin 0.76s linear infinite;
		}

		.detail-transition-text {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.04em;
			color: #d7fbff;
		}

		.detail-placeholder {
			border: 1px dashed rgba(255, 255, 255, 0.18);
			border-radius: 0.7rem;
			padding: 1rem;
			color: var(--color-muted);
			font-family: var(--font-mono);
			font-size: 0.8rem;
		}

		.pending-status-notice {
			border: 1px solid rgba(212, 237, 49, 0.35);
			background: rgba(212, 237, 49, 0.08);
			border-radius: 0.7rem;
			padding: 0.7rem 0.85rem;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			color: #ecff9d;
		}

		.flowchart-board {
			border: 1px solid rgba(0, 229, 255, 0.25);
			background: linear-gradient(135deg, rgba(0, 229, 255, 0.06), rgba(255, 255, 255, 0.02));
			border-radius: 0.7rem;
			padding: 0.95rem;
		}

		.flow-empty {
			font-family: var(--font-mono);
			font-size: 0.77rem;
			color: var(--color-muted);
			padding: 0.55rem;
		}

		.flow-sequence {
			display: flex;
			flex-direction: column;
			gap: 0.45rem;
		}

		.flow-step {
			display: flex;
			gap: 0.68rem;
			align-items: flex-start;
		}

		.flow-bullet {
			width: 0.74rem;
			height: 0.74rem;
			border-radius: 999px;
			margin-top: 0.28rem;
			box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.08);
			flex-shrink: 0;
		}

		.flow-step-start .flow-bullet { background: #8fff6c; }
		.flow-step-input .flow-bullet { background: #4de6ff; }
		.flow-step-process .flow-bullet { background: #d4ed31; }
		.flow-step-child .flow-bullet { background: #7ae3ff; }
		.flow-step-tool .flow-bullet { background: #7bffb8; }
		.flow-step-output .flow-bullet { background: #ffd66b; }
		.flow-step-end .flow-bullet { background: #ff8493; }

		.flow-toggle-wrap {
			padding-left: 1.45rem;
			margin-top: 0.25rem;
		}

		.flow-compact-note {
			border: 1px dashed rgba(255, 255, 255, 0.2);
			background: rgba(255, 255, 255, 0.04);
			border-radius: 0.55rem;
			padding: 0.45rem 0.55rem;
			margin-bottom: 0.45rem;
		}

		.flow-compact-note .flow-title {
			font-family: var(--font-mono);
			font-size: 0.76rem;
			letter-spacing: 0.05em;
		}

		.flow-compact-note .flow-meta {
			margin-top: 0.12rem;
		}

		.flow-toggle-btn {
			border: 1px solid rgba(0, 229, 255, 0.35);
			background: rgba(0, 229, 255, 0.1);
			color: #d6f9ff;
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.04em;
			padding: 0.36rem 0.6rem;
			border-radius: 0.5rem;
			text-transform: uppercase;
		}

		.flow-toggle-btn:hover {
			background: rgba(0, 229, 255, 0.18);
			border-color: rgba(0, 229, 255, 0.6);
		}

		.flow-content {
			border: 1px solid rgba(255, 255, 255, 0.1);
			background: rgba(0, 0, 0, 0.24);
			border-radius: 0.55rem;
			padding: 0.52rem 0.6rem;
			flex-grow: 1;
		}

		.flow-title {
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.flow-meta {
			font-family: var(--font-mono);
			font-size: 0.73rem;
			color: var(--color-muted);
			margin-top: 0.16rem;
			word-break: break-all;
		}

		.flow-connector {
			display: flex;
			padding-left: 0.32rem;
			height: 1rem;
		}

		.flow-connector span {
			width: 2px;
			background: linear-gradient(to bottom, rgba(0, 229, 255, 0.7), rgba(212, 237, 49, 0.7));
			border-radius: 999px;
		}

		.raw-toolbar {
			display: flex;
			gap: 0.5rem;
			flex-wrap: wrap;
		}

		.raw-hidden-state {
			border: 1px dashed rgba(255, 255, 255, 0.2);
			border-radius: 0.7rem;
			padding: 0.85rem;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			color: var(--color-muted);
			background: rgba(0, 0, 0, 0.14);
		}

		.json-view {
			background: #0f0f0f;
			border: 1px solid rgba(255, 255, 255, 0.1);
			color: #d7d7d7;
			border-radius: 0.7rem;
			max-height: 360px;
			overflow: auto;
			padding: 0.9rem;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			line-height: 1.5;
			white-space: pre;
		}

		.inline-code {
			font-family: var(--font-mono);
			font-size: 0.76rem;
			word-break: break-all;
		}

		@keyframes spin {
			to { transform: rotate(360deg); }
		}

		@media (max-width: 991.98px) {
			.feedback-toast {
				top: 0.85rem;
				right: 0.7rem;
				left: 0.7rem;
				max-width: none;
				min-width: 0;
			}

			.floating-loading {
				top: 0.8rem;
				max-width: calc(100vw - 1rem);
			}

			.section-title {
				font-size: 0.98rem;
			}

			.report-table thead th,
			.report-table tbody td {
				font-size: 0.78rem;
			}
		}
	</style>
</head>
<body>
	<div id="floatingLoading" class="floating-loading" role="status" aria-live="polite">
		<span class="floating-loading-dot" aria-hidden="true"></span>
		<span id="floatingLoadingText">Loading data...</span>
	</div>

	<main class="container tech-shell py-4 py-lg-5">
		<section class="panel hero-panel rounded-3 p-3 p-md-4 mb-4">
			<div class="d-flex flex-column flex-lg-row align-items-start justify-content-between gap-3">
				<div>
					<p class="tech-kicker mb-2">// REPORTING</p>
					<h1 class="h3 text-uppercase mb-2">LangSmith Reports Dashboard</h1>
					<p class="mb-0 text-muted-tech">Browse traces, select a run, and inspect complete run details from one workspace.</p>
					<p class="muted-text mb-0"><a href="/" class="text-decoration-underline">Hub</a> &gt; <a href="/reports" class="text-decoration-underline">Reports</a></p>
				</div>
				<div class="d-flex flex-wrap gap-2">
					<a href="https://smith.langchain.com/" target="_blank" rel="noopener noreferrer" class="btn btn-tech-outline">Go To LangSmith</a>
					<button type="button" class="btn btn-tech-primary" id="refreshRunsButton">Refresh Runs</button>
				</div>
			</div>
		</section>

		<div class="feedback-toast is-hidden" id="feedbackAlert" role="alert"></div>

		<div class="row g-4">
			<div class="col-12 col-xl-5">
				<section class="panel rounded-3 p-3 p-md-4 h-100">
					<div class="d-flex align-items-center justify-content-between mb-3">
						<div>
							<p class="tech-kicker mb-1">[ read ]</p>
							<h2 class="section-title mb-0">Run List</h2>
						</div>
						<span id="summaryText" class="text-muted-tech small">{{ len .LangSmithRuns }} runs loaded</span>
					</div>

					<div class="table-responsive">
						<table class="table table-hover align-middle report-table">
							<thead>
								<tr>
									<th>ID</th>
									<th>Name</th>
									<th>Type</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody id="runsTableBody">
								{{ if .LangSmithRuns }}
									{{ range .LangSmithRuns }}
										<tr data-run-id="{{ .ID }}">
											<td class="inline-code">{{ .ID }}</td>
											<td>{{ .Name }}</td>
											<td class="text-uppercase">{{ .RunType }}</td>
											<td>
												<button type="button" class="btn btn-sm btn-tech-outline select-run-btn" data-run-id="{{ .ID }}">Open</button>
											</td>
										</tr>
									{{ end }}
								{{ else }}
									<tr id="emptyStateRow">
										<td colspan="4" class="text-center text-muted-tech py-4">[ data_missing ] no run report available</td>
									</tr>
								{{ end }}
							</tbody>
						</table>
					</div>
				</section>
			</div>

			<div class="col-12 col-xl-7">
				<section class="panel rounded-3 p-3 p-md-4 h-100 detail-stage" id="detailStage">
					<div class="d-flex align-items-center justify-content-between mb-3">
						<div>
							<p class="tech-kicker mb-1">[ inspect ]</p>
							<h2 class="section-title mb-0">Run Detail</h2>
						</div>
						<span id="selectedRunLabel" class="text-muted-tech small">No run selected</span>
					</div>

					<div id="pendingStatusNotice" class="pending-status-notice d-none align-items-center gap-2 mb-3" role="status" aria-live="polite">
						<div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
						<span>Status is pending, waiting for completion... auto refresh every 15 seconds.</span>
					</div>

					<div id="detailPlaceholder" class="detail-placeholder mb-3">Select a run from the left table to load full report details.</div>

					<div id="detailContent" class="d-none">
						<div class="row g-2 mb-3">
							<div class="col-12 col-md-6">
								<div class="metric-box">
									<div class="metric-label">Run ID</div>
									<div class="metric-value" id="metricRunID">-</div>
								</div>
							</div>
							<div class="col-12 col-md-6">
								<div class="metric-box">
									<div class="metric-label">Status</div>
									<div class="metric-value text-uppercase" id="metricStatus">-</div>
								</div>
							</div>
							<div class="col-12 col-md-6">
								<div class="metric-box">
									<div class="metric-label">Start Time</div>
									<div class="metric-value" id="metricStart">-</div>
								</div>
							</div>
							<div class="col-12 col-md-6">
								<div class="metric-box">
									<div class="metric-label">End Time</div>
									<div class="metric-value" id="metricEnd">-</div>
								</div>
							</div>
							<div class="col-12 col-md-4">
								<div class="metric-box">
									<div class="metric-label">Prompt Tokens</div>
									<div class="metric-value" id="metricPromptTokens">-</div>
								</div>
							</div>
							<div class="col-12 col-md-4">
								<div class="metric-box">
									<div class="metric-label">Completion Tokens</div>
									<div class="metric-value" id="metricCompletionTokens">-</div>
								</div>
							</div>
							<div class="col-12 col-md-4">
								<div class="metric-box">
									<div class="metric-label">Total Tokens</div>
									<div class="metric-value" id="metricTotalTokens">-</div>
								</div>
							</div>
						</div>

						<div class="mb-3">
							<p class="tech-kicker mb-2">[ flowchart ]</p>
							<div id="flowchartBoard" class="flowchart-board">
								<div class="flow-empty">Flowchart will appear after selecting a run.</div>
							</div>
						</div>

						<div class="mb-2 d-flex align-items-center justify-content-between">
							<p class="tech-kicker mb-0">[ raw payload ]</p>
							<div class="raw-toolbar">
								<button type="button" id="unhideRawButton" class="btn btn-sm btn-tech-outline">Unhide Raw</button>
								<button type="button" id="hideRawButton" class="btn btn-sm btn-tech-outline" disabled>Hide Raw</button>
								<button type="button" id="copyJsonButton" class="btn btn-sm btn-tech-outline" disabled>Copy JSON</button>
							</div>
						</div>
						<div id="rawHiddenState" class="raw-hidden-state mb-2">Raw payload is hidden by default. Click <strong>Unhide Raw</strong> to reveal full JSON.</div>
						<div id="rawDataContainer" class="d-none">
							<pre id="jsonView" class="json-view mb-0">{}</pre>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>

	<script>
		const reportsBaseURL = "{{ .ReportsBaseURL }}" || "/api/reports/";
		const PENDING_RUN_REFRESH_INTERVAL_MS = 15000;
		const FEEDBACK_SHOW_DELAY_MS = 120;
		const FEEDBACK_HIDE_DELAY_MS = 220;
		const FEEDBACK_AUTO_HIDE_MS = 4200;

		const state = {
			runs: [],
			selectedRunID: "",
			selectedRun: null,
			listLoading: false,
			detailLoading: false,
			autoRefreshInFlight: false,
			pendingAutoRefreshTimer: null,
			rawVisible: false,
			flowExpanded: false,
			floatingLoadingCount: 0,
			floatingLoadingHideTimer: null,
			feedbackShowTimerId: null,
			feedbackHideTimerId: null,
			feedbackAutoHideTimerId: null,
		};

		const ui = {
			refreshRunsButton: document.getElementById("refreshRunsButton"),
			runsTableBody: document.getElementById("runsTableBody"),
			summaryText: document.getElementById("summaryText"),
			feedbackAlert: document.getElementById("feedbackAlert"),
			floatingLoading: document.getElementById("floatingLoading"),
			floatingLoadingText: document.getElementById("floatingLoadingText"),
			detailPlaceholder: document.getElementById("detailPlaceholder"),
			detailContent: document.getElementById("detailContent"),
			selectedRunLabel: document.getElementById("selectedRunLabel"),
			metricRunID: document.getElementById("metricRunID"),
			metricStatus: document.getElementById("metricStatus"),
			metricStart: document.getElementById("metricStart"),
			metricEnd: document.getElementById("metricEnd"),
			metricPromptTokens: document.getElementById("metricPromptTokens"),
			metricCompletionTokens: document.getElementById("metricCompletionTokens"),
			metricTotalTokens: document.getElementById("metricTotalTokens"),
			flowchartBoard: document.getElementById("flowchartBoard"),
			unhideRawButton: document.getElementById("unhideRawButton"),
			hideRawButton: document.getElementById("hideRawButton"),
			rawHiddenState: document.getElementById("rawHiddenState"),
			rawDataContainer: document.getElementById("rawDataContainer"),
			jsonView: document.getElementById("jsonView"),
			copyJsonButton: document.getElementById("copyJsonButton"),
			pendingStatusNotice: document.getElementById("pendingStatusNotice"),
		};

		function clearFeedbackTimers() {
			if (state.feedbackShowTimerId) {
				window.clearTimeout(state.feedbackShowTimerId);
				state.feedbackShowTimerId = null;
			}

			if (state.feedbackHideTimerId) {
				window.clearTimeout(state.feedbackHideTimerId);
				state.feedbackHideTimerId = null;
			}

			if (state.feedbackAutoHideTimerId) {
				window.clearTimeout(state.feedbackAutoHideTimerId);
				state.feedbackAutoHideTimerId = null;
			}
		}

		function applyFeedbackToast(type, text, hidden) {
			ui.feedbackAlert.classList.remove("is-warning", "is-error");

			if (!hidden) {
				if (type === "danger") {
					ui.feedbackAlert.classList.add("is-error");
				} else if (type === "warning") {
					ui.feedbackAlert.classList.add("is-warning");
				}
			}

			ui.feedbackAlert.textContent = hidden ? "" : text;
			ui.feedbackAlert.classList.toggle("is-hidden", hidden);
		}

		function clearFloatingLoadingHideTimer() {
			if (!state.floatingLoadingHideTimer) {
				return;
			}

			window.clearTimeout(state.floatingLoadingHideTimer);
			state.floatingLoadingHideTimer = null;
		}

		function showFloatingLoading(message) {
			clearFloatingLoadingHideTimer();

			state.floatingLoadingCount += 1;
			if (message) {
				ui.floatingLoadingText.textContent = message;
			}

			ui.floatingLoading.classList.add("show");
		}

		function hideFloatingLoading() {
			state.floatingLoadingCount = Math.max(0, state.floatingLoadingCount - 1);
			if (state.floatingLoadingCount > 0) {
				return;
			}

			clearFloatingLoadingHideTimer();
			state.floatingLoadingHideTimer = window.setTimeout(() => {
				ui.floatingLoading.classList.remove("show");
				state.floatingLoadingHideTimer = null;
			}, 90);
		}

		function setPendingStatusNotice(isPending) {
			ui.pendingStatusNotice.classList.toggle("d-flex", isPending);
			ui.pendingStatusNotice.classList.toggle("d-none", !isPending);
		}

		function escapeHTML(value) {
			return String(value)
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll('"', "&quot;")
				.replaceAll("'", "&#39;");
		}

		function showAlert(type, text) {
			clearFeedbackTimers();

			state.feedbackShowTimerId = window.setTimeout(() => {
				applyFeedbackToast(type, text, false);
				state.feedbackShowTimerId = null;

				state.feedbackAutoHideTimerId = window.setTimeout(() => {
					hideAlert();
				}, FEEDBACK_AUTO_HIDE_MS);
			}, FEEDBACK_SHOW_DELAY_MS);
		}

		function hideAlert() {
			clearFeedbackTimers();

			state.feedbackHideTimerId = window.setTimeout(() => {
				applyFeedbackToast("success", "", true);
				state.feedbackHideTimerId = null;
			}, FEEDBACK_HIDE_DELAY_MS);
		}

		function setListLoading(isLoading) {
			state.listLoading = isLoading;
			ui.refreshRunsButton.disabled = isLoading;

			if (isLoading) {
				showFloatingLoading("Syncing run list from API...");
				return;
			}

			hideFloatingLoading();
		}

		function setDetailLoading(isLoading, options = {}) {
			const { showVisualFeedback = true, lockRunButtons = true } = options;
			state.detailLoading = isLoading;

			if (showVisualFeedback) {
				if (isLoading) {
					showFloatingLoading("Loading selected run detail...");
				} else {
					hideFloatingLoading();
				}
			}

			if (lockRunButtons) {
				const selectButtons = ui.runsTableBody.querySelectorAll(".select-run-btn");
				selectButtons.forEach((button) => {
					button.disabled = isLoading;
				});
			}
		}

		function setRawVisible(isVisible) {
			state.rawVisible = isVisible;
			ui.rawDataContainer.classList.toggle("d-none", !isVisible);
			ui.rawHiddenState.classList.toggle("d-none", isVisible);
			ui.unhideRawButton.disabled = isVisible || !state.selectedRun;
			ui.hideRawButton.disabled = !isVisible;
			ui.copyJsonButton.disabled = !state.selectedRun;
		}

		function formatDateTime(value) {
			if (!value) {
				return "-";
			}

			const date = new Date(value);
			if (Number.isNaN(date.getTime())) {
				return "-";
			}

			return date.toLocaleString("en-US", {
				year: "numeric",
				month: "short",
				day: "2-digit",
				hour: "2-digit",
				minute: "2-digit",
				second: "2-digit",
				hour12: false,
			});
		}

		function toDisplayValue(value) {
			if (value === null || value === undefined || value === "") {
				return "-";
			}
			return String(value);
		}

		function normalizeRunStatus(value) {
			if (value === null || value === undefined) {
				return "";
			}
			return String(value).trim().toLowerCase();
		}

		function normalizeToolName(value) {
			if (value === null || value === undefined) {
				return "";
			}

			const parsed = String(value).trim();
			if (!parsed) {
				return "";
			}

			const genericNames = new Set(["tool", "tools", "toolnode", "tool_node"]);
			if (genericNames.has(parsed.toLowerCase())) {
				return "";
			}

			return parsed;
		}

		function addToolName(toolSet, value) {
			const normalized = normalizeToolName(value);
			if (normalized) {
				toolSet.add(normalized);
			}
		}

		function collectToolNamesFromToolCalls(toolCalls, toolSet) {
			if (!Array.isArray(toolCalls)) {
				return;
			}

			toolCalls.forEach((toolCall) => {
				if (!toolCall || typeof toolCall !== "object") {
					return;
				}

				addToolName(toolSet, toolCall.name);
				addToolName(toolSet, toolCall.tool_name);

				if (toolCall.function && typeof toolCall.function === "object") {
					addToolName(toolSet, toolCall.function.name);
				}
			});
		}

		function collectToolNamesFromMessages(messages, toolSet) {
			if (!Array.isArray(messages)) {
				return;
			}

			messages.forEach((message) => {
				if (!message || typeof message !== "object") {
					return;
				}

				const messageType = normalizeRunStatus(message.type || message.role);
				if (messageType === "tool") {
					addToolName(toolSet, message.name);
				}

				collectToolNamesFromToolCalls(message.tool_calls, toolSet);
				if (message.additional_kwargs && typeof message.additional_kwargs === "object") {
					collectToolNamesFromToolCalls(message.additional_kwargs.tool_calls, toolSet);
				}

				if (Array.isArray(message.content)) {
					message.content.forEach((part) => {
						if (!part || typeof part !== "object") {
							return;
						}

						collectToolNamesFromToolCalls(part.tool_calls, toolSet);
						addToolName(toolSet, part.name);
						addToolName(toolSet, part.tool_name);

						if (part.function && typeof part.function === "object") {
							addToolName(toolSet, part.function.name);
						}
					});
				}
			});
		}

		function stopPendingAutoRefresh() {
			if (state.pendingAutoRefreshTimer) {
				window.clearTimeout(state.pendingAutoRefreshTimer);
				state.pendingAutoRefreshTimer = null;
			}
		}

		function schedulePendingAutoRefresh(runID) {
			stopPendingAutoRefresh();

			if (!runID) {
				return;
			}

			state.pendingAutoRefreshTimer = window.setTimeout(async () => {
				if (!state.selectedRunID || state.selectedRunID !== runID) {
					stopPendingAutoRefresh();
					return;
				}

				if (state.autoRefreshInFlight || state.detailLoading) {
					schedulePendingAutoRefresh(runID);
					return;
				}

				state.autoRefreshInFlight = true;
				try {
					await loadRunDetail(runID, { mode: "auto" });
				} finally {
					state.autoRefreshInFlight = false;
				}
			}, PENDING_RUN_REFRESH_INTERVAL_MS);
		}

		function syncPendingAutoRefresh(runID, runDetail) {
			const isPending = normalizeRunStatus(runDetail && runDetail.status) === "pending";
			const shouldContinue = Boolean(runID) && state.selectedRunID === runID && isPending;

			if (shouldContinue) {
				schedulePendingAutoRefresh(runID);
				return;
			}

			stopPendingAutoRefresh();
		}

		function updateSummary(count) {
			ui.summaryText.textContent = `${count} runs loaded`;
		}

		function markSelectedRun(runID) {
			const rows = ui.runsTableBody.querySelectorAll("tr[data-run-id]");
			rows.forEach((row) => {
				row.classList.toggle("is-selected", row.dataset.runId === runID);
			});
		}

		function extractMessagePreview(runDetail) {
			const messages = runDetail && runDetail.outputs && Array.isArray(runDetail.outputs.messages)
				? runDetail.outputs.messages
				: [];
			const aiMessage = messages.find((item) => item && item.type === "ai");
			if (!aiMessage || !aiMessage.content) {
				return null;
			}
			return String(aiMessage.content);
		}

		function extractToolNames(runDetail) {
			const toolSet = new Set();

			const extraToolNames = runDetail && runDetail.extra && Array.isArray(runDetail.extra.tool_names)
				? runDetail.extra.tool_names
				: [];
			extraToolNames.forEach((name) => addToolName(toolSet, name));

			const childRuns = runDetail && Array.isArray(runDetail.child_runs) ? runDetail.child_runs : [];
			childRuns.forEach((child) => {
				if (!child || typeof child !== "object") {
					return;
				}

				if (normalizeRunStatus(child.run_type) === "tool") {
					addToolName(toolSet, child.name);
				}
			});

			const inputMessages = runDetail && runDetail.inputs && Array.isArray(runDetail.inputs.messages)
				? runDetail.inputs.messages
				: [];
			collectToolNamesFromMessages(inputMessages, toolSet);

			const outputMessages = runDetail && runDetail.outputs && Array.isArray(runDetail.outputs.messages)
				? runDetail.outputs.messages
				: [];
			collectToolNamesFromMessages(outputMessages, toolSet);

			return Array.from(toolSet);
		}

		function renderFlowchart(runDetail) {
			const steps = [];
			steps.push({ title: "Start", meta: formatDateTime(runDetail.start_time), tone: "start" });

			const inputMessages = runDetail && runDetail.inputs && Array.isArray(runDetail.inputs.messages)
				? runDetail.inputs.messages
				: [];
			if (inputMessages.length > 0) {
				steps.push({ title: "Input Messages", meta: `${inputMessages.length} item(s)`, tone: "input" });
			} else {
				const inputKeys = runDetail && runDetail.inputs ? Object.keys(runDetail.inputs).length : 0;
				steps.push({ title: "Input Context", meta: `${inputKeys} key(s)`, tone: "input" });
			}

			const childRuns = runDetail && Array.isArray(runDetail.child_runs) ? runDetail.child_runs : [];
			const toolNames = extractToolNames(runDetail);
			const maxVisibleChildRuns = 6;
			const extraChildCount = Math.max(childRuns.length - maxVisibleChildRuns, 0);
			let hiddenChildCount = 0;
			if (childRuns.length > 0) {
				const visibleChildRuns = state.flowExpanded
					? childRuns
					: childRuns.slice(0, maxVisibleChildRuns);

				hiddenChildCount = Math.max(childRuns.length - visibleChildRuns.length, 0);

				visibleChildRuns.forEach((child, index) => {
					const childName = child && child.name ? child.name : `Child Run ${index + 1}`;
					const childType = child && child.run_type ? String(child.run_type).toUpperCase() : "STEP";
					const childTypeNormalized = normalizeRunStatus(child && child.run_type);
					const isToolStep = childTypeNormalized === "tool";
					const childID = child && child.id ? String(child.id) : "-";
					const compactID = childID === "-" ? childID : `${childID.slice(0, 8)}...`;

					steps.push({
						title: isToolStep ? `Tool: ${childName}` : childName,
						meta: `${childType} · ${compactID}`,
						tone: isToolStep ? "tool" : "child",
					});
				});
			} else {
				steps.push({
					title: "Processing",
					meta: runDetail && runDetail.run_type ? String(runDetail.run_type).toUpperCase() : "CHAIN",
					tone: "process",
				});
			}

			if (toolNames.length > 0) {
				steps.push({
					title: "Tools Used",
					meta: toolNames.join(" | "),
					tone: "tool",
				});
			}

			const outputMessages = runDetail && runDetail.outputs && Array.isArray(runDetail.outputs.messages)
				? runDetail.outputs.messages
				: [];
			steps.push({
				title: "Output",
				meta: outputMessages.length > 0 ? `${outputMessages.length} message(s)` : "No output message",
				tone: "output",
			});
			steps.push({ title: "End", meta: formatDateTime(runDetail.end_time), tone: "end" });

			const html = steps.map((step, index) => {
				const connector = index < steps.length - 1
					? '<div class="flow-connector"><span></span></div>'
					: "";

				return `
					<div class="flow-step flow-step-${escapeHTML(step.tone)}">
						<div class="flow-bullet" aria-hidden="true"></div>
						<div class="flow-content">
							<div class="flow-title">${escapeHTML(step.title)}</div>
							<div class="flow-meta">${escapeHTML(step.meta || "-")}</div>
						</div>
					</div>
					${connector}
				`;
			}).join("");

			const compactNotice = extraChildCount > 0 && !state.flowExpanded
				? `
					<div class="flow-compact-note">
						<div class="flow-title">+${hiddenChildCount} More</div>
						<div class="flow-meta">hidden for compact layout</div>
					</div>
				`
				: "";

			const toggleControl = extraChildCount > 0
				? `
					<div class="flow-toggle-wrap">
						${compactNotice}
						<button type="button" class="flow-toggle-btn" data-flow-toggle="true">
							${state.flowExpanded ? `Hide ${extraChildCount} extra step(s)` : `Show +${hiddenChildCount} more step(s)`}
						</button>
					</div>
				`
				: "";

			ui.flowchartBoard.innerHTML = `<div class="flow-sequence">${html}</div>${toggleControl}`;

			const flowToggleBtn = ui.flowchartBoard.querySelector("[data-flow-toggle]");
			if (flowToggleBtn) {
				flowToggleBtn.addEventListener("click", () => {
					state.flowExpanded = !state.flowExpanded;
					renderFlowchart(runDetail);
				});
			}
		}

		function renderDetail(runDetail) {
			state.selectedRun = runDetail;
			state.flowExpanded = false;
			ui.detailPlaceholder.classList.add("d-none");
			ui.detailContent.classList.remove("d-none");

			ui.metricRunID.textContent = toDisplayValue(runDetail.id);
			ui.metricStatus.textContent = toDisplayValue(runDetail.status);
			ui.metricStart.textContent = formatDateTime(runDetail.start_time);
			ui.metricEnd.textContent = formatDateTime(runDetail.end_time);
			ui.metricPromptTokens.textContent = toDisplayValue(runDetail.prompt_tokens);
			ui.metricCompletionTokens.textContent = toDisplayValue(runDetail.completion_tokens);
			ui.metricTotalTokens.textContent = toDisplayValue(runDetail.total_tokens);
			const statusNormalized = normalizeRunStatus(runDetail.status);
			setPendingStatusNotice(statusNormalized === "pending");
			ui.selectedRunLabel.textContent = statusNormalized === "pending"
				? `Selected Run: ${toDisplayValue(runDetail.id)} | pending (auto refresh 15s)`
				: `Selected Run: ${toDisplayValue(runDetail.id)}`;
			renderFlowchart(runDetail);

			const cloned = { ...runDetail };
			const preview = extractMessagePreview(runDetail);
			if (preview) {
				cloned.message_preview = preview;
			}
			ui.jsonView.textContent = JSON.stringify(cloned, null, 2);
			setRawVisible(false);
		}

		function resetDetailView() {
			state.selectedRun = null;
			state.flowExpanded = false;
			stopPendingAutoRefresh();
			setPendingStatusNotice(false);
			ui.detailContent.classList.add("d-none");
			ui.detailPlaceholder.classList.remove("d-none");
			ui.selectedRunLabel.textContent = "No run selected";
			ui.flowchartBoard.innerHTML = '<div class="flow-empty">Flowchart will appear after selecting a run.</div>';
			ui.jsonView.textContent = "{}";
			setRawVisible(false);
		}

		function renderRuns(rows) {
			ui.runsTableBody.innerHTML = "";

			if (!rows.length) {
				const emptyRow = document.createElement("tr");
				emptyRow.id = "emptyStateRow";
				emptyRow.innerHTML = "<td colspan=\"4\" class=\"text-center text-muted-tech py-4\">[ data_missing ] no run report available</td>";
				ui.runsTableBody.appendChild(emptyRow);
				updateSummary(0);
				return;
			}

			rows.forEach((run) => {
				const tr = document.createElement("tr");
				tr.dataset.runId = run.id;
				tr.innerHTML = `
					<td class="inline-code">${run.id || "-"}</td>
					<td>${run.name || "-"}</td>
					<td class="text-uppercase">${run.run_type || "-"}</td>
					<td><button type="button" class="btn btn-sm btn-tech-outline select-run-btn" data-run-id="${run.id || ""}">Open</button></td>
				`;
				ui.runsTableBody.appendChild(tr);
			});

			updateSummary(rows.length);

			const runIds = new Set(rows.map((run) => run.id));
			if (state.selectedRunID && !runIds.has(state.selectedRunID)) {
				state.selectedRunID = "";
				resetDetailView();
			}

			markSelectedRun(state.selectedRunID);
		}

		function attachRunHandlers() {
			const buttons = ui.runsTableBody.querySelectorAll(".select-run-btn");
			buttons.forEach((button) => {
				button.addEventListener("click", () => {
					const runID = button.dataset.runId;
					if (!runID) {
						return;
					}
					loadRunDetail(runID);
				});
			});
		}

		async function fetchJSON(url) {
			const response = await fetch(url, {
				headers: { "Accept": "application/json" },
			});

			let payload = null;
			try {
				payload = await response.json();
			} catch (_) {
				payload = null;
			}

			if (!response.ok) {
				const reason = payload && payload.message ? payload.message : `request failed (${response.status})`;
				throw new Error(reason);
			}

			if (!payload || payload.success !== true) {
				const reason = payload && payload.message ? payload.message : "invalid API response";
				throw new Error(reason);
			}

			return payload.data;
		}

		async function refreshRuns() {
			hideAlert();
			setListLoading(true);

			try {
				const data = await fetchJSON(`${reportsBaseURL}langsmith`);
				state.runs = Array.isArray(data) ? data : [];
				renderRuns(state.runs);
				attachRunHandlers();
				showAlert("success", "Run list synchronized successfully.");
			} catch (error) {
				showAlert("danger", `Failed to refresh runs: ${error.message}`);
			} finally {
				setListLoading(false);
			}
		}

		async function loadRunDetail(runID, options = {}) {
			const { mode = "manual" } = options;
			const isAuto = mode === "auto";

			if (!isAuto && state.detailLoading) {
				return;
			}

			if (!runID) {
				return;
			}

			if (!isAuto) {
				hideAlert();
			}

			if (!isAuto) {
				setDetailLoading(true, { showVisualFeedback: true, lockRunButtons: true });
				setPendingStatusNotice(false);
			}

			stopPendingAutoRefresh();
			const previousSelectedRunID = state.selectedRunID;
			if (!isAuto) {
				state.selectedRunID = runID;
				markSelectedRun(runID);
			}

			try {
				const detail = await fetchJSON(`${reportsBaseURL}langsmith/${encodeURIComponent(runID)}`);

				// Avoid stale render when selection changed while request was in flight.
				if (state.selectedRunID && state.selectedRunID !== runID) {
					return;
				}

				renderDetail(detail || {});
				syncPendingAutoRefresh(runID, detail || {});
			} catch (error) {
				if (!isAuto) {
					state.selectedRunID = previousSelectedRunID;
					markSelectedRun(previousSelectedRunID);
					if (!state.selectedRun) {
						resetDetailView();
					}
					showAlert("danger", `Failed to load run detail: ${error.message}`);
				} else {
					const currentStatus = normalizeRunStatus(state.selectedRun && state.selectedRun.status);
					if (state.selectedRunID === runID && currentStatus === "pending") {
						schedulePendingAutoRefresh(runID);
					}
				}
			} finally {
				if (!isAuto) {
					setDetailLoading(false, { showVisualFeedback: true, lockRunButtons: true });
				}
			}
		}

		function hydrateInitialRuns() {
			const rows = ui.runsTableBody.querySelectorAll("tr[data-run-id]");
			const hydrated = [];

			rows.forEach((row) => {
				const cells = row.querySelectorAll("td");
				hydrated.push({
					id: row.dataset.runId || "",
					name: cells[1] ? cells[1].textContent.trim() : "",
					run_type: cells[2] ? cells[2].textContent.trim() : "",
				});
			});

			state.runs = hydrated;
			updateSummary(hydrated.length);
			attachRunHandlers();
			setRawVisible(false);
			ui.copyJsonButton.disabled = true;
		}

		ui.refreshRunsButton.addEventListener("click", refreshRuns);
		ui.unhideRawButton.addEventListener("click", () => setRawVisible(true));
		ui.hideRawButton.addEventListener("click", () => setRawVisible(false));

		ui.copyJsonButton.addEventListener("click", async () => {
			if (!state.selectedRun) {
				showAlert("warning", "No run detail selected to copy.");
				return;
			}

			try {
				await navigator.clipboard.writeText(JSON.stringify(state.selectedRun, null, 2));
				showAlert("success", "Run detail JSON copied to clipboard.");
			} catch (_) {
				showAlert("warning", "Clipboard copy failed. Please copy manually from the JSON panel.");
			}
		});

		window.addEventListener("beforeunload", () => {
			stopPendingAutoRefresh();
		});

		hydrateInitialRuns();
	</script>
</body>
</html>
