<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Access Manager</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<style>
		:root {
			--color-bg: #090909;
			--color-bg-soft: #121212;
			--color-panel: #1a1a1a;
			--color-panel-line: rgba(255, 255, 255, 0.1);
			--color-text: #ffffff;
			--color-muted: #a0a0a0;
			--color-accent: #d4ed31;
			--color-cyan: #00e5ff;
			--color-danger: #ff4d5f;
			--font-primary: "Rajdhani", "Segoe UI", sans-serif;
			--font-mono: "JetBrains Mono", Consolas, monospace;
		}

		body {
			font-family: var(--font-primary);
			color: var(--color-text);
			background-color: var(--color-bg);
			background-image:
				linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				radial-gradient(circle at 12% -8%, rgba(212, 237, 49, 0.18), transparent 35%),
				radial-gradient(circle at 95% 8%, rgba(0, 229, 255, 0.12), transparent 28%);
			background-size: 40px 40px, 40px 40px, auto, auto;
			min-height: 100vh;
		}

		.tech-shell {
			max-width: 1240px;
		}

		.panel {
			background: linear-gradient(145deg, rgba(26, 26, 26, 0.98), rgba(18, 18, 18, 0.98));
			border: 1px solid var(--color-panel-line);
			box-shadow: 0 20px 34px rgba(0, 0, 0, 0.35);
		}

		.hero-panel {
			position: relative;
			overflow: hidden;
		}

		.hero-panel::after {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(120deg, rgba(212, 237, 49, 0.09), transparent 38%);
			pointer-events: none;
		}

		.tech-kicker {
			font-family: var(--font-mono);
			font-size: 0.74rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--color-accent);
		}

		.section-title {
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-size: 1.08rem;
			margin-bottom: 1rem;
		}

		.text-muted-tech {
			color: var(--color-muted) !important;
		}

		.font-mono {
			font-family: var(--font-mono);
			font-size: 0.8rem;
			word-break: break-all;
		}

		.form-label {
			color: var(--color-muted);
			text-transform: uppercase;
			font-size: 0.78rem;
			letter-spacing: 0.06em;
			margin-bottom: 0.35rem;
		}

		.form-control {
			background-color: var(--color-bg-soft);
			border-color: var(--color-panel-line);
			color: var(--color-text);
		}

		.form-control:focus {
			background-color: var(--color-bg-soft);
			border-color: var(--color-accent);
			box-shadow: 0 0 0 0.2rem rgba(212, 237, 49, 0.18);
			color: var(--color-text);
		}

		.form-control::placeholder {
			color: #707070;
		}

		.btn-tech-primary {
			--bs-btn-bg: var(--color-accent);
			--bs-btn-border-color: var(--color-accent);
			--bs-btn-color: #141414;
			--bs-btn-hover-bg: #e1ff3f;
			--bs-btn-hover-border-color: #e1ff3f;
			--bs-btn-active-bg: #c6df2d;
			--bs-btn-active-border-color: #c6df2d;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-outline {
			--bs-btn-color: var(--color-text);
			--bs-btn-border-color: var(--color-panel-line);
			--bs-btn-hover-bg: rgba(255, 255, 255, 0.09);
			--bs-btn-hover-border-color: rgba(255, 255, 255, 0.2);
			--bs-btn-active-bg: rgba(255, 255, 255, 0.12);
			--bs-btn-active-border-color: rgba(255, 255, 255, 0.25);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-danger {
			--bs-btn-bg: transparent;
			--bs-btn-border-color: rgba(255, 77, 95, 0.55);
			--bs-btn-color: #ffb8bf;
			--bs-btn-hover-bg: rgba(255, 77, 95, 0.14);
			--bs-btn-hover-border-color: rgba(255, 77, 95, 0.9);
			--bs-btn-hover-color: #ffd8dd;
			--bs-btn-active-bg: rgba(255, 77, 95, 0.2);
			--bs-btn-active-border-color: var(--color-danger);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			font-size: 0.72rem;
		}

		.access-table {
			--bs-table-bg: transparent;
			--bs-table-color: var(--color-text);
			--bs-table-border-color: rgba(255, 255, 255, 0.08);
			--bs-table-striped-bg: rgba(255, 255, 255, 0.02);
			--bs-table-hover-bg: rgba(212, 237, 49, 0.08);
			margin-bottom: 0;
		}

		.access-table thead th {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #c6c6c6;
			border-bottom-width: 1px;
			white-space: nowrap;
		}

		.status-pill {
			display: inline-flex;
			align-items: center;
			padding: 0.2rem 0.6rem;
			border-radius: 999px;
			font-size: 0.72rem;
			font-family: var(--font-mono);
			letter-spacing: 0.03em;
			border: 1px solid transparent;
		}

		.status-pill.active {
			background-color: rgba(212, 237, 49, 0.14);
			border-color: rgba(212, 237, 49, 0.6);
			color: #f2ffc0;
		}

		.status-pill.expired {
			background-color: rgba(255, 77, 95, 0.13);
			border-color: rgba(255, 77, 95, 0.5);
			color: #ffb8bf;
		}

		@media (max-width: 991.98px) {
			.section-title {
				font-size: 0.98rem;
			}

			.access-table thead th,
			.access-table tbody td {
				font-size: 0.78rem;
			}
		}
	</style>
</head>
<body>
	<main class="container tech-shell py-4 py-lg-5">
		<section class="panel hero-panel rounded-3 p-3 p-md-4 mb-4">
			<div class="d-flex flex-column flex-lg-row align-items-start justify-content-between gap-3">
				<div>
					<p class="tech-kicker mb-2">// ACCESS CONTROL</p>
					<h1 class="h3 text-uppercase mb-2">Manager Access Dashboard</h1>
					<p class="mb-0 text-muted-tech">Kelola data access: tambah user, lihat status aktif, dan delete akses dari panel ini.</p>
				</div>
				<button type="button" class="btn btn-tech-outline" id="refreshButton">Refresh Data</button>
			</div>
		</section>

		<div class="row g-4">
			<div class="col-12 col-lg-4">
				<section class="panel rounded-3 p-3 p-md-4 h-100">
					<p class="tech-kicker mb-2">[ write ]</p>
					<h2 class="section-title">Add Access</h2>
					<form id="addAccessForm" novalidate>
						<div class="mb-3">
							<label class="form-label" for="nameInput">Name</label>
							<input class="form-control" id="nameInput" name="name" placeholder="John Manager" required />
						</div>
						<div class="mb-3">
							<label class="form-label" for="numberInput">Number</label>
							<input class="form-control" id="numberInput" name="number" placeholder="6281234567890" required />
						</div>
						<div class="mb-3">
							<label class="form-label" for="expiredInput">Expired At</label>
							<input class="form-control" id="expiredInput" name="expired_at" type="datetime-local" required />
						</div>
						<div class="d-flex gap-2 mt-4">
							<button type="submit" class="btn btn-tech-primary flex-grow-1" id="addButton">Add</button>
							<button type="button" class="btn btn-tech-outline" id="resetButton">Reset</button>
						</div>
						<div class="alert d-none mt-3 py-2 px-3 mb-0" id="formMessage" role="alert"></div>
					</form>
				</section>
			</div>

			<div class="col-12 col-lg-8">
				<section class="panel rounded-3 p-3 p-md-4">
					<div class="d-flex align-items-center justify-content-between mb-3">
						<div>
							<p class="tech-kicker mb-1">[ read ]</p>
							<h2 class="section-title mb-0">Access List</h2>
						</div>
						<span id="summaryText" class="text-muted-tech small">{{ len .AccessList }} access loaded</span>
					</div>

					<div id="loadingView" class="d-none align-items-center gap-2 mb-3 text-muted-tech small">
						<div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
						<span>Syncing data from API...</span>
					</div>

					<div class="table-responsive">
						<table class="table table-hover align-middle access-table">
							<thead>
								<tr>
									<th>Name</th>
									<th>Number</th>
									<th>JID</th>
									<th>Created</th>
									<th>Expired</th>
									<th>Status</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody id="accessTableBody">
								{{ if .AccessList }}
									{{ range .AccessList }}
										<tr data-number="{{ .Number }}">
											<td>{{ .Name }}</td>
											<td class="font-mono">{{ .Number }}</td>
											<td class="font-mono">{{ .JID }}</td>
											<td class="timestamp" data-unix="{{ .CreatedAt }}">-</td>
											<td class="timestamp" data-unix="{{ .ExpiredAt }}">-</td>
											<td><span class="status-pill" data-expired-at="{{ .ExpiredAt }}">-</span></td>
											<td>
												<button type="button" class="btn btn-sm btn-tech-danger delete-btn" data-number="{{ .Number }}">Delete</button>
											</td>
										</tr>
									{{ end }}
								{{ else }}
									<tr id="emptyStateRow">
										<td colspan="7" class="text-center text-muted-tech py-4">[ data_missing ] access list kosong</td>
									</tr>
								{{ end }}
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</div>
	</main>

	<script>
		const apiBaseURL = "{{ .AccessBaseURL }}" || "/api/access/";

		const ui = {
			form: document.getElementById("addAccessForm"),
			nameInput: document.getElementById("nameInput"),
			numberInput: document.getElementById("numberInput"),
			expiredInput: document.getElementById("expiredInput"),
			addButton: document.getElementById("addButton"),
			resetButton: document.getElementById("resetButton"),
			refreshButton: document.getElementById("refreshButton"),
			formMessage: document.getElementById("formMessage"),
			loadingView: document.getElementById("loadingView"),
			accessTableBody: document.getElementById("accessTableBody"),
			summaryText: document.getElementById("summaryText"),
		};

		function setLoading(isLoading) {
			ui.loadingView.classList.toggle("d-none", !isLoading);
			ui.loadingView.classList.toggle("d-flex", isLoading);
			ui.refreshButton.disabled = isLoading;
			ui.addButton.disabled = isLoading;
		}

		function setFormMessage(message, isError) {
			if (!message) {
				ui.formMessage.className = "alert d-none mt-3 py-2 px-3 mb-0";
				ui.formMessage.textContent = "";
				return;
			}

			ui.formMessage.textContent = message;
			ui.formMessage.className = `alert mt-3 py-2 px-3 mb-0 ${isError ? "alert-danger" : "alert-success"}`;
		}

		function formatDate(unixSeconds) {
			const value = Number(unixSeconds);
			if (!value) {
				return "-";
			}

			const date = new Date(value * 1000);
			if (Number.isNaN(date.getTime())) {
				return "-";
			}

			return date.toLocaleString("id-ID", {
				year: "numeric",
				month: "short",
				day: "2-digit",
				hour: "2-digit",
				minute: "2-digit",
			});
		}

		function isExpired(unixSeconds) {
			const value = Number(unixSeconds);
			if (!value) {
				return false;
			}
			return value < Math.floor(Date.now() / 1000);
		}

		function updateStatusPill(el, expiredAtUnix) {
			const expired = isExpired(expiredAtUnix);
			el.textContent = expired ? "Expired" : "Active";
			el.classList.toggle("expired", expired);
			el.classList.toggle("active", !expired);
		}

		function setSummary(count) {
			ui.summaryText.textContent = `${count} access loaded`;
		}

		function createCell(content, className) {
			const cell = document.createElement("td");
			if (className) {
				cell.className = className;
			}
			cell.textContent = content;
			return cell;
		}

		function addDeleteButtonCell(number) {
			const cell = document.createElement("td");
			const button = document.createElement("button");
			button.type = "button";
			button.className = "btn btn-sm btn-tech-danger delete-btn";
			button.dataset.number = number;
			button.textContent = "Delete";
			button.addEventListener("click", () => deleteAccess(number));
			cell.appendChild(button);
			return cell;
		}

		function buildRow(item) {
			const tr = document.createElement("tr");
			tr.dataset.number = item.number || "";

			tr.appendChild(createCell(item.name || "-"));
			tr.appendChild(createCell(item.number || "-", "font-mono"));
			tr.appendChild(createCell(item.jid || "-", "font-mono"));
			tr.appendChild(createCell(formatDate(item.created_at)));
			tr.appendChild(createCell(formatDate(item.expired_at)));

			const statusCell = document.createElement("td");
			const statusPill = document.createElement("span");
			statusPill.className = "status-pill";
			updateStatusPill(statusPill, item.expired_at);
			statusCell.appendChild(statusPill);
			tr.appendChild(statusCell);

			tr.appendChild(addDeleteButtonCell(item.number || ""));
			return tr;
		}

		function bindDeleteButtons() {
			const deleteButtons = ui.accessTableBody.querySelectorAll(".delete-btn");
			deleteButtons.forEach((button) => {
				button.addEventListener("click", () => {
					deleteAccess(button.dataset.number || "");
				});
			});
		}

		function hydrateServerRenderedRows() {
			const timestampCells = ui.accessTableBody.querySelectorAll(".timestamp");
			timestampCells.forEach((cell) => {
				cell.textContent = formatDate(cell.dataset.unix);
			});

			const statusPills = ui.accessTableBody.querySelectorAll(".status-pill[data-expired-at]");
			statusPills.forEach((pill) => updateStatusPill(pill, pill.dataset.expiredAt));

			bindDeleteButtons();

			const renderedRows = ui.accessTableBody.querySelectorAll("tr[data-number]").length;
			setSummary(renderedRows);
		}

		function renderTable(items) {
			ui.accessTableBody.innerHTML = "";

			if (!items.length) {
				const emptyRow = document.createElement("tr");
				emptyRow.id = "emptyStateRow";
				emptyRow.innerHTML = "<td colspan=\"7\" class=\"text-center text-muted-tech py-4\">[ data_missing ] access list kosong</td>";
				ui.accessTableBody.appendChild(emptyRow);
				setSummary(0);
				return;
			}

			const sorted = [...items].sort((a, b) => (Number(b.created_at) || 0) - (Number(a.created_at) || 0));
			sorted.forEach((item) => ui.accessTableBody.appendChild(buildRow(item)));
			setSummary(sorted.length);
		}

		async function requestJSON(url, options) {
			const response = await fetch(url, options);
			let result = {};

			try {
				result = await response.json();
			} catch (_) {
				result = {};
			}

			if (!response.ok || !result.success) {
				throw new Error(result.message || "Request failed");
			}

			return result;
		}

		async function fetchAccessList() {
			setLoading(true);
			try {
				const result = await requestJSON(apiBaseURL, { method: "GET" });
				const rows = Array.isArray(result.data) ? result.data : [];
				renderTable(rows);
			} catch (error) {
				setFormMessage(`Failed loading data: ${error.message}`, true);
			} finally {
				setLoading(false);
			}
		}

		async function addAccess(event) {
			event.preventDefault();
			setFormMessage("", false);

			const name = ui.nameInput.value.trim();
			const number = ui.numberInput.value.trim();
			const expiredAtRaw = ui.expiredInput.value;
			const expiredAtUnix = Math.floor(new Date(expiredAtRaw).getTime() / 1000);

			if (!name || !number || !expiredAtRaw || Number.isNaN(expiredAtUnix)) {
				setFormMessage("Please fill all fields with valid values.", true);
				return;
			}

			ui.addButton.disabled = true;

			try {
				await requestJSON(apiBaseURL, {
					method: "PUT",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({
						name,
						number,
						expired_at: expiredAtUnix,
					}),
				});

				ui.form.reset();
				setFormMessage("Access added successfully.", false);
				await fetchAccessList();
			} catch (error) {
				setFormMessage(`Failed to add access: ${error.message}`, true);
			} finally {
				ui.addButton.disabled = false;
			}
		}

		async function deleteAccess(number) {
			if (!number) {
				return;
			}

			const confirmed = window.confirm(`Delete access for ${number}?`);
			if (!confirmed) {
				return;
			}

			try {
				await requestJSON(apiBaseURL, {
					method: "DELETE",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({ number }),
				});

				setFormMessage("Access deleted successfully.", false);
				await fetchAccessList();
			} catch (error) {
				setFormMessage(`Failed to delete access: ${error.message}`, true);
			}
		}

		ui.form.addEventListener("submit", addAccess);
		ui.resetButton.addEventListener("click", () => {
			ui.form.reset();
			setFormMessage("", false);
		});
		ui.refreshButton.addEventListener("click", fetchAccessList);

		hydrateServerRenderedRows();
	</script>
</body>
</html>
