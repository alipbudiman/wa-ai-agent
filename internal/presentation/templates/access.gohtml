<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Access Manager</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<style>
		:root {
			--color-bg: #090909;
			--color-bg-soft: #121212;
			--color-panel: #1a1a1a;
			--color-panel-line: rgba(255, 255, 255, 0.1);
			--color-text: #ffffff;
			--color-muted: #a0a0a0;
			--color-accent: #d4ed31;
			--color-cyan: #00e5ff;
			--color-danger: #ff4d5f;
			--font-primary: "Rajdhani", "Segoe UI", sans-serif;
			--font-mono: "JetBrains Mono", Consolas, monospace;
		}

		body {
			font-family: var(--font-primary);
			color: var(--color-text);
			background-color: var(--color-bg);
			background-image:
				linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				radial-gradient(circle at 12% -8%, rgba(212, 237, 49, 0.18), transparent 35%),
				radial-gradient(circle at 95% 8%, rgba(0, 229, 255, 0.12), transparent 28%);
			background-size: 40px 40px, 40px 40px, auto, auto;
			min-height: 100vh;
		}

		.tech-shell {
			max-width: 1240px;
		}

		.panel {
			background: linear-gradient(145deg, rgba(26, 26, 26, 0.98), rgba(18, 18, 18, 0.98));
			border: 1px solid var(--color-panel-line);
			box-shadow: 0 20px 34px rgba(0, 0, 0, 0.35);
		}

		.hero-panel {
			position: relative;
			overflow: hidden;
		}

		.hero-panel::after {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(120deg, rgba(212, 237, 49, 0.09), transparent 38%);
			pointer-events: none;
		}

		.tech-kicker {
			font-family: var(--font-mono);
			font-size: 0.74rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--color-accent);
		}

		.section-title {
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-size: 1.08rem;
			margin-bottom: 1rem;
		}

		.text-muted-tech {
			color: var(--color-muted) !important;
		}

		.font-mono {
			font-family: var(--font-mono);
			font-size: 0.8rem;
			word-break: break-all;
		}

		.form-label {
			color: var(--color-muted);
			text-transform: uppercase;
			font-size: 0.78rem;
			letter-spacing: 0.06em;
			margin-bottom: 0.35rem;
		}

		.form-control {
			background-color: var(--color-bg-soft);
			border-color: var(--color-panel-line);
			color: var(--color-text);
		}

		.form-control:focus {
			background-color: var(--color-bg-soft);
			border-color: var(--color-accent);
			box-shadow: 0 0 0 0.2rem rgba(212, 237, 49, 0.18);
			color: var(--color-text);
		}

		.form-control::placeholder {
			color: #707070;
		}

		.btn-tech-primary {
			--bs-btn-bg: var(--color-accent);
			--bs-btn-border-color: var(--color-accent);
			--bs-btn-color: #141414;
			--bs-btn-hover-bg: #e1ff3f;
			--bs-btn-hover-border-color: #e1ff3f;
			--bs-btn-active-bg: #c6df2d;
			--bs-btn-active-border-color: #c6df2d;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-outline {
			--bs-btn-color: var(--color-text);
			--bs-btn-border-color: var(--color-panel-line);
			--bs-btn-hover-bg: rgba(255, 255, 255, 0.09);
			--bs-btn-hover-border-color: rgba(255, 255, 255, 0.2);
			--bs-btn-active-bg: rgba(255, 255, 255, 0.12);
			--bs-btn-active-border-color: rgba(255, 255, 255, 0.25);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-danger {
			--bs-btn-bg: transparent;
			--bs-btn-border-color: rgba(255, 77, 95, 0.55);
			--bs-btn-color: #ffb8bf;
			--bs-btn-hover-bg: rgba(255, 77, 95, 0.14);
			--bs-btn-hover-border-color: rgba(255, 77, 95, 0.9);
			--bs-btn-hover-color: #ffd8dd;
			--bs-btn-active-bg: rgba(255, 77, 95, 0.2);
			--bs-btn-active-border-color: var(--color-danger);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			font-size: 0.72rem;
		}

		.floating-loading {
			position: fixed;
			top: 0.95rem;
			left: 50%;
			transform: translate(-50%, -12px);
			z-index: 1300;
			display: flex;
			align-items: center;
			gap: 0.62rem;
			max-width: min(560px, calc(100vw - 1.4rem));
			padding: 0.72rem 0.95rem;
			border: 1px solid rgba(0, 229, 255, 0.4);
			background: rgba(0, 229, 255, 0.09);
			backdrop-filter: blur(6px);
			border-radius: 0.65rem;
			color: #c9f7ff;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.03em;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
		}

		.floating-loading.show {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, 0);
		}

		.floating-loading-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 50%;
			background: var(--color-accent);
			box-shadow: 0 0 10px rgba(212, 237, 49, 0.8);
			flex-shrink: 0;
		}

		.feedback-toast {
			position: fixed;
			top: 1.05rem;
			right: 1rem;
			z-index: 1320;
			min-width: 270px;
			max-width: min(92vw, 460px);
			padding: 0.7rem 0.9rem;
			border: 1px solid rgba(0, 229, 255, 0.46);
			background: rgba(0, 229, 255, 0.13);
			color: #d8fbff;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			letter-spacing: 0.03em;
			border-radius: 0.62rem;
			box-shadow: 0 14px 26px rgba(0, 0, 0, 0.42);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-12px);
			pointer-events: none;
			transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
		}

		.feedback-toast.is-hidden {
			opacity: 0;
			visibility: hidden;
			transform: translateY(-12px);
		}

		.feedback-toast:not(.is-hidden) {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.feedback-toast.is-warning {
			border-color: rgba(255, 214, 107, 0.54);
			background: rgba(255, 214, 107, 0.16);
			color: #ffe8ad;
		}

		.feedback-toast.is-error {
			border-color: rgba(255, 77, 95, 0.56);
			background: rgba(255, 77, 95, 0.17);
			color: #ffd0d5;
		}

		.access-table {
			--bs-table-bg: transparent;
			--bs-table-color: var(--color-text);
			--bs-table-border-color: rgba(255, 255, 255, 0.08);
			--bs-table-striped-bg: rgba(255, 255, 255, 0.02);
			--bs-table-hover-bg: rgba(212, 237, 49, 0.08);
			margin-bottom: 0;
		}

		.access-table thead th {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #c6c6c6;
			border-bottom-width: 1px;
			white-space: nowrap;
		}

		.status-pill {
			display: inline-flex;
			align-items: center;
			padding: 0.2rem 0.6rem;
			border-radius: 999px;
			font-size: 0.72rem;
			font-family: var(--font-mono);
			letter-spacing: 0.03em;
			border: 1px solid transparent;
		}

		.status-pill.active {
			background-color: rgba(212, 237, 49, 0.14);
			border-color: rgba(212, 237, 49, 0.6);
			color: #f2ffc0;
		}

		.status-pill.expired {
			background-color: rgba(255, 77, 95, 0.13);
			border-color: rgba(255, 77, 95, 0.5);
			color: #ffb8bf;
		}

        .muted-text {
			color: var(--color-muted);
		}

		.muted-text a {
			color: #d6d6d6;
		}

		.muted-text a:hover {
			color: #ffffff;
		}

		@media (max-width: 991.98px) {
			.feedback-toast {
				top: 0.85rem;
				right: 0.7rem;
				left: 0.7rem;
				max-width: none;
				min-width: 0;
			}

			.floating-loading {
				top: 0.8rem;
				max-width: calc(100vw - 1rem);
			}

			.section-title {
				font-size: 0.98rem;
			}

			.access-table thead th,
			.access-table tbody td {
				font-size: 0.78rem;
			}
		}
	</style>
</head>
<body>
	<div id="floatingLoading" class="floating-loading" role="status" aria-live="polite">
		<span class="floating-loading-dot" aria-hidden="true"></span>
		<span id="floatingLoadingText">Loading data...</span>
	</div>

	<div id="feedbackToast" class="feedback-toast is-hidden" role="alert"></div>

	<main class="container tech-shell py-4 py-lg-5">
		<section class="panel hero-panel rounded-3 p-3 p-md-4 mb-4">
			<div class="d-flex flex-column flex-lg-row align-items-start justify-content-between gap-3">
				<div>
					<p class="tech-kicker mb-2">// ACCESS CONTROL</p>
					<h1 class="h3 text-uppercase mb-2">Manager Access Dashboard</h1>
					<p class="mb-0 text-muted-tech">Manage access records from one panel: add users, monitor active status, and delete entries when needed.</p>
				    <p class="muted-text mb-0"><a href="/" class="text-decoration-underline">Hub</a> &gt; <a href="/access" class="text-decoration-underline">Access Control</a></p>
				</div>
				<button type="button" class="btn btn-tech-outline" id="refreshButton">Refresh Data</button>
			</div>
		</section>

		<div class="row g-4">
			<div class="col-12 col-lg-4">
				<section class="panel rounded-3 p-3 p-md-4 h-100">
					<p class="tech-kicker mb-2">[ write ]</p>
					<h2 class="section-title">Add Access</h2>
					<form id="addAccessForm" novalidate>
						<div class="mb-3">
							<label class="form-label" for="nameInput">Name</label>
							<input class="form-control" id="nameInput" name="name" placeholder="John Manager" required />
						</div>
						<div class="mb-3">
							<label class="form-label" for="numberInput">Number</label>
							<input class="form-control" id="numberInput" name="number" placeholder="6281234567890" required />
						</div>
						<div class="mb-3">
							<label class="form-label" for="expiredInput">Expired At</label>
							<input class="form-control" id="expiredInput" name="expired_at" type="datetime-local" required />
						</div>
						<div class="d-flex gap-2 mt-4">
							<button type="submit" class="btn btn-tech-primary flex-grow-1" id="addButton">Add</button>
							<button type="button" class="btn btn-tech-outline" id="resetButton">Reset</button>
						</div>
					</form>
				</section>
			</div>

			<div class="col-12 col-lg-8">
				<section class="panel rounded-3 p-3 p-md-4">
					<div class="d-flex align-items-center justify-content-between mb-3">
						<div>
							<p class="tech-kicker mb-1">[ read ]</p>
							<h2 class="section-title mb-0">Access List</h2>
						</div>
						<span id="summaryText" class="text-muted-tech small">{{ len .AccessList }} access loaded</span>
					</div>

					<div class="table-responsive" id="accessTableWrap">
						<table class="table table-hover align-middle access-table">
							<thead>
								<tr>
									<th>Name</th>
									<th>Number</th>
									<th>JID</th>
									<th>Created</th>
									<th>Expired</th>
									<th>Status</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody id="accessTableBody">
								{{ if .AccessList }}
									{{ range .AccessList }}
										<tr data-number="{{ .Number }}">
											<td>{{ .Name }}</td>
											<td class="font-mono">{{ .Number }}</td>
											<td class="font-mono">{{ .JID }}</td>
											<td class="timestamp" data-unix="{{ .CreatedAt }}">-</td>
											<td class="timestamp" data-unix="{{ .ExpiredAt }}">-</td>
											<td><span class="status-pill" data-expired-at="{{ .ExpiredAt }}">-</span></td>
											<td>
												<button type="button" class="btn btn-sm btn-tech-danger delete-btn" data-number="{{ .Number }}">Delete</button>
											</td>
										</tr>
									{{ end }}
								{{ else }}
									<tr id="emptyStateRow">
										<td colspan="7" class="text-center text-muted-tech py-4">[ data_missing ] access list is empty</td>
									</tr>
								{{ end }}
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</div>
	</main>

	<script>
		const apiBaseURL = "{{ .AccessBaseURL }}" || "/api/access/";
		const LOADING_HIDE_DELAY_MS = 90;
		const FEEDBACK_SHOW_DELAY_MS = 120;
		const FEEDBACK_HIDE_DELAY_MS = 220;
		const FEEDBACK_AUTO_HIDE_MS = 4200;

		const ui = {
			form: document.getElementById("addAccessForm"),
			nameInput: document.getElementById("nameInput"),
			numberInput: document.getElementById("numberInput"),
			expiredInput: document.getElementById("expiredInput"),
			addButton: document.getElementById("addButton"),
			resetButton: document.getElementById("resetButton"),
			refreshButton: document.getElementById("refreshButton"),
			floatingLoading: document.getElementById("floatingLoading"),
			floatingLoadingText: document.getElementById("floatingLoadingText"),
			feedbackToast: document.getElementById("feedbackToast"),
			accessTableWrap: document.getElementById("accessTableWrap"),
			accessTableBody: document.getElementById("accessTableBody"),
			summaryText: document.getElementById("summaryText"),
		};

		const state = {
			loadingCount: 0,
			loadingHideTimerId: null,
			feedbackShowTimerId: null,
			feedbackHideTimerId: null,
			feedbackAutoHideTimerId: null,
		};

		function clearLoadingHideTimer() {
			if (!state.loadingHideTimerId) {
				return;
			}

			window.clearTimeout(state.loadingHideTimerId);
			state.loadingHideTimerId = null;
		}

		function showFloatingLoading(message) {
			clearLoadingHideTimer();
			state.loadingCount += 1;

			if (message) {
				ui.floatingLoadingText.textContent = message;
			}

			ui.floatingLoading.classList.add("show");
		}

		function hideFloatingLoading() {
			state.loadingCount = Math.max(0, state.loadingCount - 1);
			if (state.loadingCount > 0) {
				return;
			}

			clearLoadingHideTimer();
			state.loadingHideTimerId = window.setTimeout(() => {
				ui.floatingLoading.classList.remove("show");
				state.loadingHideTimerId = null;
			}, LOADING_HIDE_DELAY_MS);
		}

		function setLoading(isLoading, message) {
			ui.refreshButton.disabled = isLoading;
			ui.addButton.disabled = isLoading;

			const deleteButtons = ui.accessTableBody.querySelectorAll(".delete-btn");
			deleteButtons.forEach((button) => {
				button.disabled = isLoading;
			});

			if (isLoading) {
				showFloatingLoading(message || "Syncing data from API...");
				return;
			}

			hideFloatingLoading();
		}

		function clearFeedbackTimers() {
			if (state.feedbackShowTimerId) {
				window.clearTimeout(state.feedbackShowTimerId);
				state.feedbackShowTimerId = null;
			}

			if (state.feedbackHideTimerId) {
				window.clearTimeout(state.feedbackHideTimerId);
				state.feedbackHideTimerId = null;
			}

			if (state.feedbackAutoHideTimerId) {
				window.clearTimeout(state.feedbackAutoHideTimerId);
				state.feedbackAutoHideTimerId = null;
			}
		}

		function applyFeedbackState(message, tone, hidden) {
			ui.feedbackToast.classList.remove("is-warning", "is-error");

			if (!hidden) {
				if (tone === "error") {
					ui.feedbackToast.classList.add("is-error");
				} else if (tone === "warning") {
					ui.feedbackToast.classList.add("is-warning");
				}
			}

			ui.feedbackToast.textContent = hidden ? "" : message;
			ui.feedbackToast.classList.toggle("is-hidden", hidden);
		}

		function showFeedback(message, options = {}) {
			const { tone = "info" } = options;
			clearFeedbackTimers();

			if (!message) {
				state.feedbackHideTimerId = window.setTimeout(() => {
					applyFeedbackState("", "info", true);
					state.feedbackHideTimerId = null;
				}, FEEDBACK_HIDE_DELAY_MS);
				return;
			}

			state.feedbackShowTimerId = window.setTimeout(() => {
				applyFeedbackState(message, tone, false);
				state.feedbackShowTimerId = null;

				state.feedbackAutoHideTimerId = window.setTimeout(() => {
					showFeedback("");
				}, FEEDBACK_AUTO_HIDE_MS);
			}, FEEDBACK_SHOW_DELAY_MS);
		}

		function captureScrollSnapshot() {
			return {
				pageScrollY: window.scrollY || window.pageYOffset || 0,
				tableScrollTop: ui.accessTableWrap ? ui.accessTableWrap.scrollTop : 0,
			};
		}

		function restoreScrollSnapshot(snapshot) {
			if (!snapshot) {
				return;
			}

			window.scrollTo({ top: snapshot.pageScrollY, left: 0, behavior: "auto" });

			if (ui.accessTableWrap) {
				const maxScroll = Math.max(0, ui.accessTableWrap.scrollHeight - ui.accessTableWrap.clientHeight);
				ui.accessTableWrap.scrollTop = Math.min(snapshot.tableScrollTop, maxScroll);
			}
		}

		function formatDate(unixSeconds) {
			const value = Number(unixSeconds);
			if (!value) {
				return "-";
			}

			const date = new Date(value * 1000);
			if (Number.isNaN(date.getTime())) {
				return "-";
			}

			return date.toLocaleString("en-US", {
				year: "numeric",
				month: "short",
				day: "2-digit",
				hour: "2-digit",
				minute: "2-digit",
			});
		}

		function isExpired(unixSeconds) {
			const value = Number(unixSeconds);
			if (!value) {
				return false;
			}
			return value < Math.floor(Date.now() / 1000);
		}

		function updateStatusPill(el, expiredAtUnix) {
			const expired = isExpired(expiredAtUnix);
			el.textContent = expired ? "Expired" : "Active";
			el.classList.toggle("expired", expired);
			el.classList.toggle("active", !expired);
		}

		function setSummary(count) {
			ui.summaryText.textContent = `${count} access loaded`;
		}

		function createCell(content, className) {
			const cell = document.createElement("td");
			if (className) {
				cell.className = className;
			}
			cell.textContent = content;
			return cell;
		}

		function addDeleteButtonCell(number) {
			const cell = document.createElement("td");
			const button = document.createElement("button");
			button.type = "button";
			button.className = "btn btn-sm btn-tech-danger delete-btn";
			button.dataset.number = number;
			button.textContent = "Delete";
			button.addEventListener("click", () => deleteAccess(number));
			cell.appendChild(button);
			return cell;
		}

		function buildRow(item) {
			const tr = document.createElement("tr");
			tr.dataset.number = item.number || "";

			tr.appendChild(createCell(item.name || "-"));
			tr.appendChild(createCell(item.number || "-", "font-mono"));
			tr.appendChild(createCell(item.jid || "-", "font-mono"));
			tr.appendChild(createCell(formatDate(item.created_at)));
			tr.appendChild(createCell(formatDate(item.expired_at)));

			const statusCell = document.createElement("td");
			const statusPill = document.createElement("span");
			statusPill.className = "status-pill";
			updateStatusPill(statusPill, item.expired_at);
			statusCell.appendChild(statusPill);
			tr.appendChild(statusCell);

			tr.appendChild(addDeleteButtonCell(item.number || ""));
			return tr;
		}

		function bindDeleteButtons() {
			const deleteButtons = ui.accessTableBody.querySelectorAll(".delete-btn");
			deleteButtons.forEach((button) => {
				button.addEventListener("click", () => {
					deleteAccess(button.dataset.number || "");
				});
			});
		}

		function hydrateServerRenderedRows() {
			const timestampCells = ui.accessTableBody.querySelectorAll(".timestamp");
			timestampCells.forEach((cell) => {
				cell.textContent = formatDate(cell.dataset.unix);
			});

			const statusPills = ui.accessTableBody.querySelectorAll(".status-pill[data-expired-at]");
			statusPills.forEach((pill) => updateStatusPill(pill, pill.dataset.expiredAt));

			bindDeleteButtons();

			const renderedRows = ui.accessTableBody.querySelectorAll("tr[data-number]").length;
			setSummary(renderedRows);
		}

		function renderTable(items) {
			ui.accessTableBody.innerHTML = "";

			if (!items.length) {
				const emptyRow = document.createElement("tr");
				emptyRow.id = "emptyStateRow";
				emptyRow.innerHTML = "<td colspan=\"7\" class=\"text-center text-muted-tech py-4\">[ data_missing ] access list is empty</td>";
				ui.accessTableBody.appendChild(emptyRow);
				setSummary(0);
				return;
			}

			const sorted = [...items].sort((a, b) => (Number(b.created_at) || 0) - (Number(a.created_at) || 0));
			sorted.forEach((item) => ui.accessTableBody.appendChild(buildRow(item)));
			setSummary(sorted.length);
		}

		async function requestJSON(url, options) {
			const response = await fetch(url, options);
			let result = {};

			try {
				result = await response.json();
			} catch (_) {
				result = {};
			}

			if (!response.ok || !result.success) {
				throw new Error(result.message || "Request failed");
			}

			return result;
		}

		async function fetchAccessList(options = {}) {
			const {
				preserveScroll = true,
				showSuccessMessage = "",
				loadingMessage = "Syncing data from API...",
			} = options;

			const refreshSnapshot = preserveScroll ? captureScrollSnapshot() : null;
			setLoading(true, loadingMessage);
			try {
				const result = await requestJSON(apiBaseURL, { method: "GET" });
				const rows = Array.isArray(result.data) ? result.data : [];
				renderTable(rows);

				if (refreshSnapshot) {
					window.requestAnimationFrame(() => {
						restoreScrollSnapshot(refreshSnapshot);
					});
				}

				if (showSuccessMessage) {
					showFeedback(showSuccessMessage, { tone: "info" });
				}
			} catch (error) {
				showFeedback(`Failed loading data: ${error.message}`, { tone: "error" });
			} finally {
				setLoading(false);
			}
		}

		async function addAccess(event) {
			event.preventDefault();
			showFeedback("");

			const name = ui.nameInput.value.trim();
			const number = ui.numberInput.value.trim();
			const expiredAtRaw = ui.expiredInput.value;
			const expiredAtUnix = Math.floor(new Date(expiredAtRaw).getTime() / 1000);

			if (!name || !number || !expiredAtRaw || Number.isNaN(expiredAtUnix)) {
				showFeedback("Please fill all fields with valid values.", { tone: "warning" });
				return;
			}

			ui.addButton.disabled = true;

			try {
				await requestJSON(apiBaseURL, {
					method: "PUT",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({
						name,
						number,
						expired_at: expiredAtUnix,
					}),
				});

				ui.form.reset();
				showFeedback("Access added successfully.", { tone: "info" });
				await fetchAccessList({ preserveScroll: true });
			} catch (error) {
				showFeedback(`Failed to add access: ${error.message}`, { tone: "error" });
			} finally {
				ui.addButton.disabled = false;
			}
		}

		async function deleteAccess(number) {
			if (!number) {
				return;
			}

			const confirmed = window.confirm(`Delete access for ${number}?`);
			if (!confirmed) {
				return;
			}

			try {
				await requestJSON(apiBaseURL, {
					method: "DELETE",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({ number }),
				});

				showFeedback("Access deleted successfully.", { tone: "info" });
				await fetchAccessList({ preserveScroll: true });
			} catch (error) {
				showFeedback(`Failed to delete access: ${error.message}`, { tone: "error" });
			}
		}

		ui.form.addEventListener("submit", addAccess);
		ui.resetButton.addEventListener("click", () => {
			ui.form.reset();
			showFeedback("");
		});
		ui.refreshButton.addEventListener("click", () => {
			fetchAccessList({
				preserveScroll: true,
				showSuccessMessage: "Access list synchronized successfully.",
				loadingMessage: "Syncing access records...",
			});
		});

		hydrateServerRenderedRows();
	</script>
</body>
</html>
