<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Artifacts Preview</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<style>
		:root {
			--color-bg: #090909;
			--color-panel: #1a1a1a;
			--color-panel-line: rgba(255, 255, 255, 0.1);
			--color-text: #ffffff;
			--color-muted: #a0a0a0;
			--color-accent: #d4ed31;
			--font-primary: "Rajdhani", "Segoe UI", sans-serif;
			--font-mono: "JetBrains Mono", Consolas, monospace;
		}

		body {
			min-height: 100vh;
			background-color: var(--color-bg);
			color: var(--color-text);
			font-family: var(--font-primary);
			background-image:
				linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
			background-size: 36px 36px, 36px 36px;
		}

		.shell {
			max-width: 1180px;
		}

		.panel {
			border: 1px solid var(--color-panel-line);
			background: linear-gradient(145deg, rgba(26, 26, 26, 0.98), rgba(13, 13, 13, 0.98));
			box-shadow: 0 18px 34px rgba(0, 0, 0, 0.35);
		}

		.kicker {
			font-family: var(--font-mono);
			letter-spacing: 0.1em;
			color: var(--color-accent);
			text-transform: uppercase;
			font-size: 0.72rem;
			margin-bottom: 0.5rem;
		}

		.title {
			text-transform: uppercase;
			letter-spacing: 0.06em;
			margin-bottom: 0.3rem;
		}

		.muted-text {
			color: var(--color-muted);
		}

		.muted-text a {
			color: #d6d6d6;
		}

		.muted-text a:hover {
			color: #ffffff;
		}

		.img-wrap {
			border: 1px solid var(--color-panel-line);
			border-radius: 0.75rem;
			background: rgba(255, 255, 255, 0.02);
			padding: 0.75rem;
		}

		.diagram-image {
			width: 100%;
			height: auto;
			display: block;
			border-radius: 0.5rem;
			background: #fff;
		}

		.hidden-state {
			min-height: 240px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--font-mono);
			font-size: 0.82rem;
			color: var(--color-muted);
			text-align: center;
			padding: 1.2rem;
			border-radius: 0.5rem;
			border: 1px dashed rgba(255, 255, 255, 0.18);
		}

		.btn-tech {
			--bs-btn-color: #fff;
			--bs-btn-border-color: rgba(255, 255, 255, 0.2);
			--bs-btn-hover-bg: rgba(212, 237, 49, 0.15);
			--bs-btn-hover-border-color: rgba(212, 237, 49, 0.7);
			--bs-btn-active-bg: rgba(212, 237, 49, 0.2);
			--bs-btn-active-border-color: rgba(212, 237, 49, 0.8);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			font-weight: 600;
		}

		.not-found {
			border: 1px solid rgba(255, 77, 95, 0.45);
			background: rgba(255, 77, 95, 0.12);
			color: #ffb8bf;
			font-family: var(--font-mono);
			font-size: 0.78rem;
		}
	</style>
</head>
<body>
	<main class="container shell py-4 py-lg-5">
		<section class="panel rounded-3 p-3 p-lg-4">
			<div class="mb-3">
				<p class="kicker mb-2">// Artifacts</p>
				<h1 class="title h4 mb-2">{{ .ProcessDiagramTitle }}</h1>
				<p class="muted-text mb-1">Preview image source: {{ .ProcessDiagramPath }}</p>
				<p class="muted-text mb-0"><a href="/" class="text-decoration-underline">Hub</a> &gt; <a href="/artifacts" class="text-decoration-underline">Artifacts</a></p>
			</div>

			<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
				<p class="kicker mb-0">[ Preview ]</p>
				<div class="d-flex gap-2">
					<button type="button" id="unhideButton" class="btn btn-outline-light btn-tech btn-sm">Unhide</button>
					<button type="button" id="hideButton" class="btn btn-outline-light btn-tech btn-sm" disabled>Hide</button>
					<a href="{{ .ProcessDiagramPath }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light btn-tech btn-sm">Open Image</a>
					<button type="button" id="reloadButton" class="btn btn-outline-light btn-tech btn-sm">Reload</button>
				</div>
			</div>

			<div class="img-wrap">
				<div id="hiddenState" class="hidden-state">Image is hidden by default. Click <strong>&nbsp;Unhide&nbsp;</strong> to preview the process diagram.</div>
				<img id="diagramImage" class="diagram-image d-none" alt="Process Diagram Flow" />
			</div>

			<div id="notFoundAlert" class="not-found rounded-3 py-2 px-3 mt-3 d-none">
				Image not found. Ensure the file exists at assets/artifacts/chat_agent_process_table.png and regenerate the diagram.
			</div>
		</section>
	</main>

	<script>
		const imageEl = document.getElementById("diagramImage");
		const hiddenState = document.getElementById("hiddenState");
		const unhideButton = document.getElementById("unhideButton");
		const hideButton = document.getElementById("hideButton");
		const reloadButton = document.getElementById("reloadButton");
		const notFoundAlert = document.getElementById("notFoundAlert");
		const basePath = "{{ .ProcessDiagramPath }}";
		let hasLoadedImage = false;

		function setImageVisible(isVisible) {
			hiddenState.classList.toggle("d-none", isVisible);
			imageEl.classList.toggle("d-none", !isVisible);
			unhideButton.disabled = isVisible;
			hideButton.disabled = !isVisible;
			reloadButton.disabled = !isVisible;
		}

		function refreshImage() {
			const cacheBust = `t=${Date.now()}`;
			imageEl.src = `${basePath}?${cacheBust}`;
			hasLoadedImage = true;
		}

		imageEl.addEventListener("load", () => {
			notFoundAlert.classList.add("d-none");
		});

		imageEl.addEventListener("error", () => {
			notFoundAlert.classList.remove("d-none");
		});

		unhideButton.addEventListener("click", () => {
			setImageVisible(true);
			if (!hasLoadedImage) {
				refreshImage();
			}
		});

		hideButton.addEventListener("click", () => {
			setImageVisible(false);
			notFoundAlert.classList.add("d-none");
		});

		reloadButton.addEventListener("click", refreshImage);

		setImageVisible(false);
	</script>
</body>
</html>
