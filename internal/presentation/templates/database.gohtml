<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Database Vector Store</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
	<style>
		:root {
			--color-bg: #090909;
			--color-bg-soft: #121212;
			--color-panel: #1a1a1a;
			--color-panel-line: rgba(255, 255, 255, 0.1);
			--color-text: #ffffff;
			--color-muted: #a0a0a0;
			--color-accent: #d4ed31;
			--color-cyan: #00e5ff;
			--color-danger: #ff4d5f;
			--font-primary: "Rajdhani", "Segoe UI", sans-serif;
			--font-mono: "JetBrains Mono", Consolas, monospace;
		}

		body {
			min-height: 100vh;
			background-color: var(--color-bg);
			color: var(--color-text);
			font-family: var(--font-primary);
			background-image:
				linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				radial-gradient(circle at 12% -8%, rgba(212, 237, 49, 0.16), transparent 35%),
				radial-gradient(circle at 98% 5%, rgba(0, 229, 255, 0.12), transparent 30%);
			background-size: 40px 40px, 40px 40px, auto, auto;
		}

		.database-shell {
			max-width: 1260px;
		}

		.panel {
			border: 1px solid var(--color-panel-line);
			background: linear-gradient(145deg, rgba(26, 26, 26, 0.98), rgba(18, 18, 18, 0.98));
			box-shadow: 0 18px 32px rgba(0, 0, 0, 0.34);
		}

		.tech-kicker {
			font-family: var(--font-mono);
			font-size: 0.74rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--color-accent);
		}

		.section-title {
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-size: 1.05rem;
		}

		.text-muted-tech,
		.muted-text {
			color: var(--color-muted) !important;
		}

		.muted-text a {
			color: #d6d6d6;
		}

		.muted-text a:hover {
			color: #ffffff;
		}

		.font-mono {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			word-break: break-all;
		}

		.form-label {
			color: var(--color-muted);
			text-transform: uppercase;
			font-size: 0.78rem;
			letter-spacing: 0.06em;
		}

		.form-control {
			background-color: var(--color-bg-soft);
			border-color: var(--color-panel-line);
			color: var(--color-text);
		}

		.form-control:focus {
			background-color: var(--color-bg-soft);
			border-color: var(--color-accent);
			box-shadow: 0 0 0 0.2rem rgba(212, 237, 49, 0.18);
			color: var(--color-text);
		}

		.form-control::placeholder {
			color: #707070;
		}

		.form-text {
			color: #8e8e8e;
			font-family: var(--font-mono);
			font-size: 0.72rem;
		}

		.btn-tech-primary {
			--bs-btn-bg: var(--color-accent);
			--bs-btn-border-color: var(--color-accent);
			--bs-btn-color: #141414;
			--bs-btn-hover-bg: #e1ff3f;
			--bs-btn-hover-border-color: #e1ff3f;
			--bs-btn-active-bg: #c6df2d;
			--bs-btn-active-border-color: #c6df2d;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-outline {
			--bs-btn-color: var(--color-text);
			--bs-btn-border-color: var(--color-panel-line);
			--bs-btn-hover-bg: rgba(255, 255, 255, 0.09);
			--bs-btn-hover-border-color: rgba(255, 255, 255, 0.2);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.btn-tech-danger {
			--bs-btn-bg: transparent;
			--bs-btn-border-color: rgba(255, 77, 95, 0.55);
			--bs-btn-color: #ffb8bf;
			--bs-btn-hover-bg: rgba(255, 77, 95, 0.14);
			--bs-btn-hover-border-color: rgba(255, 77, 95, 0.9);
			--bs-btn-hover-color: #ffd8dd;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			font-size: 0.72rem;
		}

		.document-table {
			--bs-table-bg: transparent;
			--bs-table-color: var(--color-text);
			--bs-table-border-color: rgba(255, 255, 255, 0.08);
			--bs-table-hover-bg: rgba(212, 237, 49, 0.08);
			margin-bottom: 0;
		}

		.document-table thead th {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #c6c6c6;
			border-bottom-width: 1px;
			white-space: nowrap;
		}

		.document-table tbody td {
			vertical-align: middle;
		}

		.floating-loading {
			position: fixed;
			top: 0.95rem;
			left: 50%;
			transform: translate(-50%, -12px);
			z-index: 1300;
			display: flex;
			align-items: center;
			gap: 0.62rem;
			max-width: min(560px, calc(100vw - 1.4rem));
			padding: 0.72rem 0.95rem;
			border: 1px solid rgba(0, 229, 255, 0.4);
			background: rgba(0, 229, 255, 0.09);
			backdrop-filter: blur(6px);
			border-radius: 0.65rem;
			color: #c9f7ff;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.03em;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
		}

		.floating-loading.show {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, 0);
		}

		.floating-loading-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 50%;
			background: var(--color-accent);
			box-shadow: 0 0 10px rgba(212, 237, 49, 0.8);
			flex-shrink: 0;
		}

		.feedback-toast {
			position: fixed;
			top: 1.05rem;
			right: 1rem;
			z-index: 1320;
			min-width: 270px;
			max-width: min(92vw, 460px);
			padding: 0.7rem 0.9rem;
			border: 1px solid rgba(0, 229, 255, 0.46);
			background: rgba(0, 229, 255, 0.13);
			color: #d8fbff;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			letter-spacing: 0.03em;
			border-radius: 0.62rem;
			box-shadow: 0 14px 26px rgba(0, 0, 0, 0.42);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-12px);
			pointer-events: none;
			transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
		}

		.feedback-toast:not(.is-hidden) {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.feedback-toast.is-error {
			border-color: rgba(255, 77, 95, 0.56);
			background: rgba(255, 77, 95, 0.17);
			color: #ffd0d5;
		}

		.feedback-toast.is-warning {
			border-color: rgba(255, 214, 107, 0.54);
			background: rgba(255, 214, 107, 0.16);
			color: #ffe8ad;
		}

		@media (max-width: 991.98px) {
			.feedback-toast {
				top: 0.85rem;
				right: 0.7rem;
				left: 0.7rem;
				max-width: none;
				min-width: 0;
			}

			.document-table thead th,
			.document-table tbody td {
				font-size: 0.78rem;
			}
		}
	</style>
</head>
<body>
	<div id="floatingLoading" class="floating-loading" role="status" aria-live="polite">
		<span class="floating-loading-dot" aria-hidden="true"></span>
		<span id="floatingLoadingText">Loading...</span>
	</div>

	<div id="feedbackToast" class="feedback-toast is-hidden" role="alert"></div>

	<main class="container database-shell py-4 py-lg-5">
		<section class="panel rounded-3 p-3 p-md-4 mb-4">
			<div class="d-flex flex-column flex-lg-row align-items-start justify-content-between gap-3">
				<div>
					<p class="tech-kicker mb-2">// VECTOR DATABASE</p>
					<h1 class="h3 text-uppercase mb-2">Document Ingestion Dashboard</h1>
					<p class="mb-1 text-muted-tech">Upload files or ingest URLs into the Brain vector store. Uploaded files remain available for review until deleted.</p>
					<p class="muted-text mb-0"><a href="/" class="text-decoration-underline">Hub</a> &gt; <a href="/database" class="text-decoration-underline">Database</a></p>
				</div>
				<button type="button" class="btn btn-tech-outline" id="refreshButton">Refresh Documents</button>
			</div>
		</section>

		<div class="row g-4">
			<div class="col-12 col-lg-5">
				<section class="panel rounded-3 p-3 p-md-4 mb-4">
					<p class="tech-kicker mb-2">[ upload ]</p>
					<h2 class="section-title mb-3">Upload &amp; Ingest</h2>
					<form id="uploadForm" novalidate>
						<div class="mb-3">
							<label class="form-label" for="uploadCategoryInput">Category</label>
							<input class="form-control" id="uploadCategoryInput" name="category" value="general" />
						</div>
						<div class="mb-3">
							<label class="form-label" for="fileInput">Documents</label>
							<input class="form-control" id="fileInput" name="files" type="file" multiple accept=".pdf,.txt,.md,.csv,.docx,.xlsx,.pptx" required />
							<div class="form-text">Supported: PDF, TXT, MD, CSV, DOCX, XLSX, PPTX.</div>
						</div>
						<button type="submit" class="btn btn-tech-primary w-100" id="uploadButton">Upload &amp; Ingest</button>
					</form>
				</section>

				<section class="panel rounded-3 p-3 p-md-4">
					<p class="tech-kicker mb-2">[ url ]</p>
					<h2 class="section-title mb-3">Ingest URLs</h2>
					<form id="urlForm" novalidate>
						<div class="mb-3">
							<label class="form-label" for="urlCategoryInput">Category</label>
							<input class="form-control" id="urlCategoryInput" name="category" value="general" />
						</div>
						<div class="mb-3">
							<label class="form-label" for="urlInput">URLs</label>
							<textarea class="form-control" id="urlInput" rows="6" placeholder="https://example.com/docs&#10;https://example.com/guide" required></textarea>
							<div class="form-text">Use one URL per line.</div>
						</div>
						<button type="submit" class="btn btn-tech-primary w-100" id="urlButton">Ingest URLs</button>
					</form>
				</section>
			</div>

			<div class="col-12 col-lg-7">
				<section class="panel rounded-3 p-3 p-md-4">
					<div class="d-flex align-items-center justify-content-between gap-3 mb-3">
						<div>
							<p class="tech-kicker mb-1">[ read ]</p>
							<h2 class="section-title mb-0">Vector Documents</h2>
						</div>
						<span id="summaryText" class="text-muted-tech small">0 documents loaded</span>
					</div>

					<div class="table-responsive" id="documentTableWrap">
						<table class="table table-hover align-middle document-table">
							<thead>
								<tr>
									<th>Source</th>
									<th>Type</th>
									<th>Category</th>
									<th>Chunks</th>
									<th>Chars</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody id="documentTableBody">
								<tr>
									<td colspan="6" class="text-center text-muted-tech py-4">[ loading ] syncing vector documents</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</div>
	</main>

	<script>
		const loadDocumentBaseURL = "{{ .LoadDocumentBaseURL }}" || "/api/load-document";
		const FEEDBACK_AUTO_HIDE_MS = 4200;

		const ui = {
			uploadForm: document.getElementById("uploadForm"),
			uploadCategoryInput: document.getElementById("uploadCategoryInput"),
			fileInput: document.getElementById("fileInput"),
			uploadButton: document.getElementById("uploadButton"),
			urlForm: document.getElementById("urlForm"),
			urlCategoryInput: document.getElementById("urlCategoryInput"),
			urlInput: document.getElementById("urlInput"),
			urlButton: document.getElementById("urlButton"),
			refreshButton: document.getElementById("refreshButton"),
			floatingLoading: document.getElementById("floatingLoading"),
			floatingLoadingText: document.getElementById("floatingLoadingText"),
			feedbackToast: document.getElementById("feedbackToast"),
			documentTableWrap: document.getElementById("documentTableWrap"),
			documentTableBody: document.getElementById("documentTableBody"),
			summaryText: document.getElementById("summaryText"),
		};

		const state = {
			loadingCount: 0,
			feedbackTimerId: null,
			documents: [],
		};

		function setButtonsDisabled(disabled) {
			ui.uploadButton.disabled = disabled;
			ui.urlButton.disabled = disabled;
			ui.refreshButton.disabled = disabled;
		}

		function showLoading(message) {
			state.loadingCount += 1;
			ui.floatingLoadingText.textContent = message || "Loading...";
			ui.floatingLoading.classList.add("show");
			setButtonsDisabled(true);
		}

		function hideLoading() {
			state.loadingCount = Math.max(0, state.loadingCount - 1);
			if (state.loadingCount > 0) {
				return;
			}

			window.setTimeout(() => {
				if (state.loadingCount === 0) {
					ui.floatingLoading.classList.remove("show");
					setButtonsDisabled(false);
				}
			}, 90);
		}

		function showFeedback(message, tone = "info") {
			window.clearTimeout(state.feedbackTimerId);
			ui.feedbackToast.textContent = message;
			ui.feedbackToast.classList.toggle("is-error", tone === "error");
			ui.feedbackToast.classList.toggle("is-warning", tone === "warning");
			ui.feedbackToast.classList.remove("is-hidden");
			state.feedbackTimerId = window.setTimeout(() => {
				ui.feedbackToast.classList.add("is-hidden");
			}, FEEDBACK_AUTO_HIDE_MS);
		}

		async function requestJSON(url, options = {}) {
			const response = await fetch(url, {
				headers: {
					Accept: "application/json",
					...(options.body instanceof FormData ? {} : { "Content-Type": "application/json" }),
					...(options.headers || {}),
				},
				...options,
			});

			const payload = await response.json().catch(() => null);
			if (!response.ok || !payload || payload.success === false) {
				const message = payload && payload.message ? payload.message : `request failed with status ${response.status}`;
				throw new Error(message);
			}

			return payload;
		}

		function formatNumber(value) {
			const numberValue = Number(value || 0);
			return Number.isFinite(numberValue) ? numberValue.toLocaleString() : "0";
		}

		function extractDocuments(payload) {
			const data = payload && payload.data ? payload.data : payload;
			if (!data || !Array.isArray(data.documents)) {
				return [];
			}
			return data.documents;
		}

		function preserveScroll() {
			return {
				pageY: window.scrollY,
				tableY: ui.documentTableWrap ? ui.documentTableWrap.scrollTop : 0,
			};
		}

		function restoreScroll(snapshot) {
			if (!snapshot) {
				return;
			}
			window.scrollTo(0, snapshot.pageY);
			if (ui.documentTableWrap) {
				ui.documentTableWrap.scrollTop = snapshot.tableY;
			}
		}

		function canOpenDocument(doc) {
			const source = String(doc.source || "").trim().toLowerCase();
			const fileType = String(doc.file_type || "").trim().toLowerCase();
			return source !== "" && fileType !== "web" && !source.startsWith("http://") && !source.startsWith("https://");
		}

		function escapeHTML(value) {
			return String(value || "")
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll("\"", "&quot;")
				.replaceAll("'", "&#039;");
		}

		function renderDocuments(documents) {
			ui.documentTableBody.innerHTML = "";
			ui.summaryText.textContent = `${documents.length} documents loaded`;

			if (documents.length === 0) {
				const row = document.createElement("tr");
				row.innerHTML = "<td colspan=\"6\" class=\"text-center text-muted-tech py-4\">[ data_missing ] no vector documents found</td>";
				ui.documentTableBody.appendChild(row);
				return;
			}

			documents.forEach((doc) => {
				const row = document.createElement("tr");
				const source = String(doc.source || "");
				const displayName = String(doc.display_name || doc.source || "");
				const fileType = escapeHTML(doc.file_type || "unknown");
				const category = escapeHTML(doc.category || "general");
				row.innerHTML = `
					<td class="font-mono"></td>
					<td>${fileType}</td>
					<td>${category}</td>
					<td>${formatNumber(doc.total_chunks)}</td>
					<td>${formatNumber(doc.total_chars)}</td>
					<td>
						<div class="d-flex flex-wrap gap-2">
							${canOpenDocument(doc) ? `<a class="btn btn-sm btn-tech-outline" href="${loadDocumentBaseURL}/file?source=${encodeURIComponent(source)}" target="_blank" rel="noopener noreferrer">Open</a>` : ""}
							<button type="button" class="btn btn-sm btn-tech-danger delete-document-btn">Delete</button>
						</div>
					</td>
				`;
				const sourceCell = row.querySelector("td");
				sourceCell.textContent = displayName || "-";
				sourceCell.title = source;
				row.querySelector(".delete-document-btn").dataset.source = source;
				ui.documentTableBody.appendChild(row);
			});
		}

		async function refreshDocuments(options = {}) {
			const snapshot = preserveScroll();
			if (!options.silent) {
				showLoading("Syncing vector documents...");
			}

			try {
				const payload = await requestJSON(`${loadDocumentBaseURL}/documents`);
				state.documents = extractDocuments(payload);
				renderDocuments(state.documents);
				restoreScroll(snapshot);
				if (!options.silent) {
					showFeedback("Vector document list refreshed.");
				}
			} catch (error) {
				showFeedback(`Failed to refresh documents: ${error.message}`, "error");
			} finally {
				if (!options.silent) {
					hideLoading();
				}
			}
		}

		async function handleUpload(event) {
			event.preventDefault();
			const files = Array.from(ui.fileInput.files || []);
			if (files.length === 0) {
				showFeedback("Select at least one document to upload.", "warning");
				return;
			}

			const formData = new FormData();
			files.forEach((file) => formData.append("files", file));
			formData.append("category", ui.uploadCategoryInput.value || "general");

			showLoading("Uploading and embedding documents...");
			try {
				const payload = await requestJSON(`${loadDocumentBaseURL}/upload`, {
					method: "POST",
					body: formData,
				});
				ui.uploadForm.reset();
				ui.uploadCategoryInput.value = "general";
				showFeedback("Documents ingested and stored.");
				await refreshDocuments({ silent: true });
			} catch (error) {
				showFeedback(`Failed to upload documents: ${error.message}`, "error");
			} finally {
				hideLoading();
			}
		}

		async function handleURLIngest(event) {
			event.preventDefault();
			const urls = ui.urlInput.value
				.split(/\r?\n/)
				.map((item) => item.trim())
				.filter(Boolean);

			if (urls.length === 0) {
				showFeedback("Add at least one URL.", "warning");
				return;
			}

			showLoading("Embedding URLs...");
			try {
				await requestJSON(`${loadDocumentBaseURL}/ingest-urls`, {
					method: "POST",
					body: JSON.stringify({
						urls,
						category: ui.urlCategoryInput.value || "general",
					}),
				});
				ui.urlForm.reset();
				ui.urlCategoryInput.value = "general";
				showFeedback("URLs ingested successfully.");
				await refreshDocuments({ silent: true });
			} catch (error) {
				showFeedback(`Failed to ingest URLs: ${error.message}`, "error");
			} finally {
				hideLoading();
			}
		}

		async function handleDelete(event) {
			const button = event.target.closest(".delete-document-btn");
			if (!button) {
				return;
			}

			const source = button.dataset.source || "";
			if (!source) {
				showFeedback("Document source is missing.", "error");
				return;
			}

			if (!window.confirm(`Delete this document file and its vector data?\n${source}`)) {
				return;
			}

			showLoading("Deleting document and vector data...");
			try {
				await requestJSON(`${loadDocumentBaseURL}/documents?source=${encodeURIComponent(source)}`, {
					method: "DELETE",
				});
				showFeedback("Document file and vector data deleted.");
				await refreshDocuments({ silent: true });
			} catch (error) {
				showFeedback(`Failed to delete document: ${error.message}`, "error");
			} finally {
				hideLoading();
			}
		}

		ui.uploadForm.addEventListener("submit", handleUpload);
		ui.urlForm.addEventListener("submit", handleURLIngest);
		ui.refreshButton.addEventListener("click", () => refreshDocuments());
		ui.documentTableBody.addEventListener("click", handleDelete);

		refreshDocuments();
	</script>
</body>
</html>
