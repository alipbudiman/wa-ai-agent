# ==== API KEYS & TOKENS (SENSITIVE) ====
# Replace these values with your actual API keys. DO NOT commit the .env file.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# ==== MODEL SELECTION ====
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OLLAMA_MODEL=minimax-m2.7:cloud

# ==== AI ENGINE CONFIG (Ollama/Anthropic Setup) ====
# If you are running Docker, use http://ollama:11434 or localhost depending on your host target.
ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_AUTH_TOKEN="ollama"
ANTHROPIC_API_KEY=""

# ==== WA AGENT SETTINGS ====
WA_REQUIRE_FULL_SYNC=true
